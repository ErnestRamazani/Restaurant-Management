<UserControl x:Class="EliteRestaurantPro.Views.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EliteRestaurantPro.ViewModels"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,18">
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                    <Run Text="{Binding SetPanelTitle, Mode=OneWay}"/>
                    <Run Text="{Binding SetPanelTitleAccent, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <TextBlock Text="{Binding SetPanelSubtitle, Mode=OneWay}"
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run FontWeight="SemiBold" Foreground="{StaticResource GoldAccentBrush}" Text="{Binding SetCloudWebsiteLabel, Mode=OneWay}"/>
                    <Run Text="{Binding SetCloudWebsiteHint, Mode=OneWay}"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SetSectionFilterLabel, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding SettingsSectionOptions}"
                              SelectedItem="{Binding SelectedSettingsSectionOption, Mode=TwoWay}"
                              Style="{StaticResource EliteComboBox}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="18"
                            Visibility="{Binding ShowBusinessSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetBusinessProfileTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetBusinessProfileLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="{Binding SetRestaurantNameLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="{Binding SetPhoneLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SetAddressLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SetWebsiteDomainLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantWebsiteDomain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SetOtherSocialLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantSocialMedia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SetLogoPathLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RestaurantLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding SetBrowseLabel, Mode=OneWay}" Command="{Binding BrowseLogoCommand}" Style="{StaticResource GhostButton}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                                    <TextBlock Text="{Binding SetHomepageBackgroundLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding HomepageBackgroundImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"/>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="{Binding SetBrowseLabel, Mode=OneWay}"
                                                Command="{Binding BrowseHomepageBackgroundCommand}"
                                                Style="{StaticResource GhostButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetPublicMenuBaseUrlLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetPublicMenuBaseUrlHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PublicMenuBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"
                                             ToolTip="{Binding SetPublicMenuBaseUrlTooltip, Mode=OneWay}"/>
                                    <Button Grid.Column="1" Content="{Binding SetUsePhoneFriendlyUrlLabel, Mode=OneWay}" Margin="10,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding ApplyPhoneFriendlyMenuUrlCommand}" Style="{StaticResource GhostButton}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetCustomerMenuTaglineLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetCustomerMenuTaglineHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CustomerMenuTagline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="{Binding SetPublicMenuAboutLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetPublicMenuAboutHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CustomerMenuAboutText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="{Binding SetPublicMenuContactLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetPublicMenuContactHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CustomerMenuContactIntro, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="{Binding SetPublicMenuNotesLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetPublicMenuNotesHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CustomerMenuNotesText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="{Binding SetOnlinePromoTitle, Mode=OneWay}"
                                           Foreground="{StaticResource GoldAccentBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SetOnlinePromoLead, Mode=OneWay}"
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <TextBlock Text="{Binding SetPromoTitleLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding OnlinePromoTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="{Binding SetPromoSubtitleLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OnlinePromoSubtitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="{Binding SetPromoCtaLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OnlinePromoCtaLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="{Binding SetPromoHeroImageLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OnlinePromoImagePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding SetBrowseLabel, Mode=OneWay}" Command="{Binding BrowseOnlinePromoImageCommand}" Style="{StaticResource GhostButton}"/>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding SetClearLabel, Mode=OneWay}" Command="{Binding ClearOnlinePromoImageCommand}" Style="{StaticResource GhostButton}"/>
                                </Grid>
                                <TextBlock Text="{Binding SetOnlineOrdersTableIdLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding SetOnlineOrdersTableIdHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding OnlineOrdersTableId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetStaffLoginPasscodeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetStaffLoginPasscodeHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding StaffLoginPasscode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetOrderCancelPasscodeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetOrderCancelPasscodeHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding OrderCancelPasscode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetAdminWebPortalLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="{Binding SetAdminWebPortalHint, Mode=OneWay}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SetSignInIdLabel, Mode=OneWay}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AdminWebSignInId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="{Binding SetPinLabel, Mode=OneWay}" Style="{StaticResource BodyText}" Margin="0,8,0,4"/>
                                <TextBox Text="{Binding AdminWebPin, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <Button Content="{Binding SetSaveBusinessProfileLabel, Mode=OneWay}"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveBusinessProfileCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowTicketsReceiptSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetTicketsTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetTicketsLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>

                            <TextBlock Text="{Binding SetReceiptPrinterLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding SetReceiptPrinterHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding InstalledPrinterNames}"
                                          Text="{Binding ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding SetRefreshLabel, Mode=OneWay}"
                                        Command="{Binding RefreshInstalledPrintersCommand}"
                                        Style="{StaticResource GhostButton}"/>
                            </Grid>

                            <TextBlock Text="{Binding SetTicketHeaderLogoLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding SetTicketHeaderLogoHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding TicketHeaderLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding SetBrowseLabel, Mode=OneWay}" Command="{Binding BrowseTicketHeaderLogoCommand}" Style="{StaticResource GhostButton}"/>
                            </Grid>

                            <TextBlock Text="{Binding SetTicketFooterLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBox Text="{Binding TicketFooterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding SetTaxIdLegalLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBox Text="{Binding TaxIdLegalInfo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding SetTicketSocialLinesLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding SetTicketSocialLinesHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <ItemsControl ItemsSource="{Binding TicketSocialMediaRows}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TicketSocialMediaRowViewModel}">
                                        <Border Margin="0,0,0,10" Padding="10" CornerRadius="6"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Background="#12000000">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DataContext.SetSocialNameExampleLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                                        <TextBox Text="{Binding PlatformName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding DataContext.SetSocialUsernameUrlLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                                        <TextBox Text="{Binding UserText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding DataContext.SetSocialIconPathLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding DataContext.SetBrowseLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                            Command="{Binding DataContext.BrowseTicketSocialIconCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource GhostButton}"/>
                                                </Grid>
                                                <Button HorizontalAlignment="Right" Content="{Binding DataContext.SetRemoveRowLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                        Command="{Binding DataContext.RemoveTicketSocialRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource GhostButton}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{Binding SetAddSocialRowLabel, Mode=OneWay}" Command="{Binding AddTicketSocialRowCommand}" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Margin="0,0,0,12"/>

                            <Button Content="{Binding SetSaveTicketsLabel, Mode=OneWay}"
                                    Command="{Binding SaveTicketReceiptLayoutCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowReservationsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetTimezoneTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetTimezoneLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SetIanaTimezoneLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <ComboBox ItemsSource="{Binding RestaurantTimeZoneOptions}"
                                      SelectedItem="{Binding RestaurantTimeZoneId, Mode=TwoWay}"
                                      Style="{StaticResource EliteComboBox}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      Margin="0,0,0,16"/>

                            <TextBlock Text="{Binding SetReservationsTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetReservationsLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SetReservationLeadDaysLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding SetReservationLeadDaysHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReservationLeadDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetReservationMaxMonthsLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding SetReservationMaxMonthsHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReservationMaxMonthsAhead, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <Button Content="{Binding SetSaveReservationSettingsLabel, Mode=OneWay}"
                                    Margin="0,16,0,0"
                                    Command="{Binding SaveReservationSettingsCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuTaxonomySection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetMenuCategoriesTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetMenuCategoriesLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SetMenuCategoriesDrinkHint, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="{Binding SetAddMenuTypeLabel, Mode=OneWay}" Command="{Binding AddMenuTaxonomyTypeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="{Binding SetRestoreEliteDefaultsLabel, Mode=OneWay}" Command="{Binding ResetMenuTaxonomyCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="{Binding SetSaveMenuCategoriesLabel, Mode=OneWay}" Command="{Binding SaveMenuTaxonomyCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding MenuTaxonomyTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MenuTaxonomyTypeEditVm}">
                                        <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DataContext.SetMenuTypeNameLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                                    <Button Grid.Column="1" Content="{Binding DataContext.SetRemoveTypeLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Command="{Binding RemoveTypeCommand}" Style="{StaticResource GhostButton}"/>
                                                </Grid>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                <CheckBox Margin="0,10,0,8" Content="{Binding DataContext.SetDrinkTypeCheckboxLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" IsChecked="{Binding IsDrink, Mode=TwoWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding DataContext.SetSectionsHint, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Button HorizontalAlignment="Left" Content="{Binding DataContext.SetAddSectionLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Command="{Binding AddSectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MenuTaxonomySectionEditVm}">
                                                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding DataContext.SetCategorySectionNameLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                                                        <Button Grid.Column="1" Content="{Binding DataContext.SetRemoveLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}"/>
                                                                    </Grid>
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                                    <TextBlock Text="{Binding DataContext.SetSubcategoriesCommaLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                                                    <TextBox Text="{Binding ItemsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuQrSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetMenuQrTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetMenuQrLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap"/>
                            <Button Content="{Binding SetPrintAllQrPdfLabel, Mode=OneWay}"
                                    Command="{Binding PrintAllMenuQrCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding MenuQrRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,12,12" Width="210">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TableLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <Image Source="{Binding QrImage}" Width="180" Height="180" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowCurrencySection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetCurrencyTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetCurrencyLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="{Binding SetDefaultCurrencyDisplayLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <ComboBox ItemsSource="{Binding CurrencyDisplayOptions}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              SelectedValue="{Binding DefaultCurrencyDisplayMode, Mode=TwoWay}"
                                              Style="{StaticResource EliteComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="{Binding SetExchangeRateLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding ExchangeRateUsdToFc, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding SetExchangeRateUpdatedLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding ExchangeRateLastUpdated, Mode=OneWay}" Style="{StaticResource EliteTextBox}" IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="{Binding SetRoundingLineSubtotalLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding RoundingOptions}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding RoundingLine, Mode=TwoWay}"
                                                  Style="{StaticResource EliteComboBox}"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding RoundingOptions}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding RoundingSubtotal, Mode=TwoWay}"
                                                  Style="{StaticResource EliteComboBox}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="{Binding SetRoundingGrandTotalLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <ComboBox ItemsSource="{Binding RoundingOptions}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              SelectedValue="{Binding RoundingGrandTotal, Mode=TwoWay}"
                                              Style="{StaticResource EliteComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                    <TextBlock Text="{Binding SetTaxServicePercentLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"
                                                 IsEnabled="{Binding CanEditTaxService}"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ServicePercent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"
                                                 IsEnabled="{Binding CanEditTaxService}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Button Content="{Binding SetSaveCurrencyPricingLabel, Mode=OneWay}"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveCurrencyPricingCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowAttendanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetAttendanceTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetAttendanceLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SetMorningStartLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBox Text="{Binding AttendanceMorningStartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetMorningEndLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceMorningEndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetNightStartLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceNightStartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetNightEndLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceNightEndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetLateGraceLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceLateGraceMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <Button Content="{Binding SetSaveAttendanceLabel, Mode=OneWay}"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveAttendanceShiftsCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowSalarySection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetSalaryTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetSalaryLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SetLateDaysPerUnitLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                            <TextBox Text="{Binding SalaryLateDaysPerAttendanceUnitText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <CheckBox Margin="0,12,0,0"
                                      Content="{Binding SetAbsenceCountsAsUnitLabel, Mode=OneWay}"
                                      IsChecked="{Binding SalaryAbsenceCountsAsAttendanceUnit, Mode=TwoWay}"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SetSalesBonusPercentLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding SalarySalesBonusPercentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="{Binding SetMaxAdvancePercentLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding SalaryMaxAdvancePercentOfGrossText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <Button Content="{Binding SetSaveSalaryLabel, Mode=OneWay}"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveSalarySettingsCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuBackgroundSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetMenuBackgroundsTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetMenuBackgroundsLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <StackPanel>
                                <TextBlock Text="{Binding SetPageLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <ComboBox ItemsSource="{Binding BackgroundPageOptions}"
                                          SelectedItem="{Binding SelectedBackgroundPageOption, Mode=TwoWay}"
                                          Style="{StaticResource EliteComboBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding SetBackgroundImagePathLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedMenuBackgroundPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="{Binding SetBrowseLabel, Mode=OneWay}"
                                            Command="{Binding BrowseMenuBackgroundCommand}"
                                            Style="{StaticResource GhostButton}"/>
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Content="{Binding SetClearLabel, Mode=OneWay}"
                                            Command="{Binding ClearMenuBackgroundCommand}"
                                            Style="{StaticResource GhostButton}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SetDimLightLabel, Mode=OneWay}"/><Run Text="{Binding BackgroundDimStrength, StringFormat={}{0:0.00}}"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="0.5" Value="{Binding BackgroundDimStrength, Mode=TwoWay}"/>

                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SetContrastLabel, Mode=OneWay}"/><Run Text="{Binding BackgroundContrastIntensity, StringFormat={}{0:0.00}}"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="0.5" Value="{Binding BackgroundContrastIntensity, Mode=TwoWay}"/>

                            <Button Content="{Binding SetSaveMenuBackgroundsLabel, Mode=OneWay}"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveMenuBackgroundCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowDatabaseSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetDatabaseTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetDatabaseLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>

                            <StackPanel>
                                <TextBlock Text="{Binding SetProviderLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <ComboBox ItemsSource="{Binding DatabaseProviders}"
                                          SelectedItem="{Binding DatabaseProvider, Mode=TwoWay}"
                                          Style="{StaticResource EliteComboBox}"/>
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding SetHostLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabaseHost, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SetPortLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabasePort, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="{Binding SetDatabaseNameLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding SetUsernameLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding DatabaseUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource HeadingSmall}">
                                    <Run Text="{Binding SetPasswordLabel, Mode=OneWay}"/>
                                    <Run Text="{Binding SetPasswordNotShownLabel, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </TextBlock>
                                <PasswordBox x:Name="DatabasePasswordBox"
                                             Style="{StaticResource ElitePasswordBox}"
                                             PasswordChanged="DatabasePasswordBox_OnPasswordChanged"/>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Visibility="{Binding HasSavedDatabasePassword, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="{Binding SetPasswordAlreadySavedLabel, Mode=OneWay}"/>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{Binding SetTestConnectionLabel, Mode=OneWay}"
                                        Margin="0,0,6,0"
                                        Command="{Binding TestDatabaseConnectionCommand}"
                                        Style="{StaticResource GhostButton}"/>
                                <Button Grid.Column="1"
                                        Content="{Binding SetSaveDatabaseLabel, Mode=OneWay}"
                                        Margin="6,0,0,0"
                                        Command="{Binding SaveDatabaseSettingsCommand}"
                                        Style="{StaticResource GoldPrimaryButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowLanguageSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SettingsLanguageTitle}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SettingsLanguageLead}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="{Binding SettingsLanguageLabel}" Style="{StaticResource HeadingSmall}"/>
                            <ComboBox Width="260"
                                      Margin="0,8,0,0"
                                      ItemsSource="{Binding UiLanguageOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedUiLanguage, Mode=TwoWay}"
                                      Style="{StaticResource EliteComboBox}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowAppearanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SetAppearanceTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SetAppearanceLead, Mode=OneWay}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Height="120"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Background="{Binding PickerPreviewBrush}"/>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <ComboBox ItemsSource="{Binding ThemeTokenOptions}"
                                              SelectedItem="{Binding SelectedTokenOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource EliteComboBox}"/>

                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SetHueLabel, Mode=OneWay}"/><Run Text="{Binding PickerHue, StringFormat={}{0:0}}"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="360" Value="{Binding PickerHue, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SetSaturationLabel, Mode=OneWay}"/><Run Text="{Binding PickerSaturation, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerSaturation, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SetLightnessLabel, Mode=OneWay}"/><Run Text="{Binding PickerLightness, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerLightness, Mode=TwoWay}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding PickerHex}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="{Binding SetApplyToTokenLabel, Mode=OneWay}"
                                                Width="190"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Command="{Binding ApplyPickerToTokenCommand}"
                                                Style="{StaticResource GoldPrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Button Content="{Binding SetApplyThemeLabel, Mode=OneWay}" Margin="0,12,0,0" Command="{Binding ApplyThemeCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding SetSaveThemeLabel, Mode=OneWay}" Margin="0,0,6,0" Command="{Binding SaveThemeCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                                <Button Grid.Column="1" Content="{Binding SetResetDefaultThemeLabel, Mode=OneWay}" Margin="6,0,0,0" Command="{Binding ResetThemeCommand}" Style="{StaticResource GhostButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
