<UserControl x:Class="EliteRestaurantPro.Views.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EliteRestaurantPro.ViewModels"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,18">
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                    <Run Text="Settings"/>
                    <Run Text=" Panel" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <TextBlock Text="Business profile, currency &amp; pricing, and appearance controls."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Section:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="220"
                              ItemsSource="{Binding SettingsSections}"
                              SelectedItem="{Binding SelectedSettingsSection, Mode=TwoWay}"
                              Style="{StaticResource EliteComboBox}"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="18"
                            Visibility="{Binding ShowBusinessSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Business Profile"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Restaurant info for receipts and ticket footer."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Restaurant name" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Phone" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="Address" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Website domain" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantWebsiteDomain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Social media" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding RestaurantSocialMedia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="Logo path" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding RestaurantLogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseLogoCommand}" Style="{StaticResource GhostButton}"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                    <TextBlock Text="Homepage background image" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding HomepageBackgroundImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"/>
                                        <Button Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="Browse"
                                                Command="{Binding BrowseHomepageBackgroundCommand}"
                                                Style="{StaticResource GhostButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Footer text for tickets" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding TicketFooterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Tax ID / legal info for receipts" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding TaxIdLegalInfo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Public menu base URL (QR codes for customers’ phones)" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Use the hosted cloud URL for production (https://starfish-app-owtoz.ondigitalocean.app). In local development, use this PC’s LAN address, not localhost, so a phone on the same Wi-Fi can open the menu. No trailing slash."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding PublicMenuBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"
                                             ToolTip="Example: https://starfish-app-owtoz.ondigitalocean.app — no trailing slash"/>
                                    <Button Grid.Column="1" Content="Use phone-friendly URL" Margin="10,0,0,0" VerticalAlignment="Top"
                                            Command="{Binding ApplyPhoneFriendlyMenuUrlCommand}" Style="{StaticResource GhostButton}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Customer menu tagline (optional)" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding CustomerMenuTagline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,18,0,0">
                                <TextBlock Text="Online order — weekly promo (PWA)"
                                           Foreground="{StaticResource GoldAccentBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Hero card on the dedicated Order online flow. Saved with Business Profile and pushed to the cloud menu."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10"/>
                                <TextBlock Text="Promo title" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding OnlinePromoTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="Promo subtitle" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OnlinePromoSubtitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="Button label (CTA)" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBox Text="{Binding OnlinePromoCtaLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Text="Hero image (optional)" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding OnlinePromoImagePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseOnlinePromoImageCommand}" Style="{StaticResource GhostButton}"/>
                                    <Button Grid.Column="2" Margin="8,0,0,0" Content="Clear" Command="{Binding ClearOnlinePromoImageCommand}" Style="{StaticResource GhostButton}"/>
                                </Grid>
                                <TextBlock Text="Online orders table id (optional)" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                <TextBlock Text="POS table id to attach guest online orders (must have an assigned server). Leave blank to use the first available staffed table."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding OnlineOrdersTableId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Staff login passcode" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Text="Customers see the menu first. Staff must enter this code before the workplace chooser opens."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding StaffLoginPasscode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <Button Content="Save Business Profile"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveBusinessProfileCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowReservationsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Reservations (public menu)"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Controls how far ahead guests can book online and how much notice is required. Saved here and pushed to the cloud API so the reservation page and server rules stay in sync."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="Lead days (X days in advance)" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="Guests may choose a date starting today + this many calendar days. Use 0 to allow any future day (still not in the past)."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReservationLeadDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="Maximum months ahead" Style="{StaticResource HeadingSmall}" Margin="0,12,0,0"/>
                            <TextBlock Text="Guests cannot book beyond this many months from today."
                                       Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ReservationMaxMonthsAhead, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <Button Content="Save reservation settings"
                                    Margin="0,16,0,0"
                                    Command="{Binding SaveReservationSettingsCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuTaxonomySection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Menu categories"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Defines menu types (e.g. Food / Drink), product categories (saved on each item), and allowed subcategories. This drives the admin menu, customer PWA, and staff web menus after you save and push."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="Check “Drink type” for the bucket that holds beverages. Legacy rows with Category “Drink” still match drink sections by subcategory."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Add menu type" Command="{Binding AddMenuTaxonomyTypeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="Restore Elite defaults" Command="{Binding ResetMenuTaxonomyCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/>
                                <Button Content="Save menu categories" Command="{Binding SaveMenuTaxonomyCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding MenuTaxonomyTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MenuTaxonomyTypeEditVm}">
                                        <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Menu type name" Style="{StaticResource HeadingSmall}"/>
                                                    <Button Grid.Column="1" Content="Remove type" Command="{Binding RemoveTypeCommand}" Style="{StaticResource GhostButton}"/>
                                                </Grid>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                <CheckBox Margin="0,10,0,8" Content="Drink type (beverages)" IsChecked="{Binding IsDrink, Mode=TwoWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="Sections (product category = section name). Subcategories: comma-separated list." Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <Button HorizontalAlignment="Left" Content="Add section" Command="{Binding AddSectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Sections}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:MenuTaxonomySectionEditVm}">
                                                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Category (section name)" Style="{StaticResource HeadingSmall}"/>
                                                                        <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}"/>
                                                                    </Grid>
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                                    <TextBlock Text="Subcategories (comma-separated)" Style="{StaticResource HeadingSmall}" Margin="0,8,0,0"/>
                                                                    <TextBox Text="{Binding ItemsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuQrSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Menu QR codes"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Each code opens the customer menu with the table preset. URL: {base URL}/menu/?table={table id}. Save Business Profile if you change the base URL."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"
                                       TextWrapping="Wrap"/>
                            <Button Content="Print all QR codes (PDF)"
                                    Command="{Binding PrintAllMenuQrCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding MenuQrRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,12,12" Width="210">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TableLabel}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <Image Source="{Binding QrImage}" Width="180" Height="180" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding Url}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowCurrencySection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Currency &amp; Pricing"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Default display, exchange rate, rounding, tax and service."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Default currency display mode" Style="{StaticResource HeadingSmall}"/>
                                    <ComboBox SelectedValuePath="Content"
                                              SelectedValue="{Binding DefaultCurrencyDisplayMode, Mode=TwoWay}"
                                              Style="{StaticResource EliteComboBox}">
                                        <ComboBoxItem Content="USD"/>
                                        <ComboBoxItem Content="FC"/>
                                        <ComboBoxItem Content="Dual"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="USD ↔ FC exchange rate" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding ExchangeRateUsdToFc, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                    <TextBlock Text="Exchange rate last updated" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding ExchangeRateLastUpdated, Mode=OneWay}" Style="{StaticResource EliteTextBox}" IsReadOnly="True"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Rounding: line / subtotal" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" SelectedValuePath="Content" SelectedValue="{Binding RoundingLine, Mode=TwoWay}" Style="{StaticResource EliteComboBox}">
                                            <ComboBoxItem Content="Nearest"/>
                                            <ComboBoxItem Content="Up"/>
                                            <ComboBoxItem Content="Down"/>
                                            <ComboBoxItem Content="None"/>
                                        </ComboBox>
                                        <ComboBox Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding RoundingSubtotal, Mode=TwoWay}" Style="{StaticResource EliteComboBox}">
                                            <ComboBoxItem Content="Nearest"/>
                                            <ComboBoxItem Content="Up"/>
                                            <ComboBoxItem Content="Down"/>
                                            <ComboBoxItem Content="None"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Rounding: grand total" Style="{StaticResource HeadingSmall}"/>
                                    <ComboBox SelectedValuePath="Content"
                                              SelectedValue="{Binding RoundingGrandTotal, Mode=TwoWay}"
                                              Style="{StaticResource EliteComboBox}">
                                        <ComboBoxItem Content="Nearest"/>
                                        <ComboBoxItem Content="Up"/>
                                        <ComboBoxItem Content="Down"/>
                                        <ComboBoxItem Content="None"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                    <TextBlock Text="Tax % / Service % (admin only)" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"
                                                 IsEnabled="{Binding CanEditTaxService}"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding ServicePercent, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"
                                                 IsEnabled="{Binding CanEditTaxService}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Button Content="Save Currency &amp; Pricing"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveCurrencyPricingCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowAttendanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Attendance &amp; shifts"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Define shift windows (local time). Used for attendance labels, late clock-in grace, payroll scheduled hours, and auto-absence rules on this PC."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>
                            <TextBlock Text="Morning shift — start (HH:mm)" Style="{StaticResource HeadingSmall}"/>
                            <TextBox Text="{Binding AttendanceMorningStartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="Morning shift — end (HH:mm)" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceMorningEndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="Night shift — start (HH:mm)" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceNightStartText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="Night shift — end (HH:mm)" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceNightEndText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <TextBlock Text="Late clock-in grace (minutes after shift start)" Style="{StaticResource HeadingSmall}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding AttendanceLateGraceMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                            <Button Content="Save attendance shift settings"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveAttendanceShiftsCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowMenuBackgroundSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Menu Backgrounds"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Set a custom image for each navigation page. Dim and contrast apply app-wide."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,12"/>

                            <StackPanel>
                                <TextBlock Text="Page" Style="{StaticResource HeadingSmall}"/>
                                <ComboBox ItemsSource="{Binding BackgroundMenuKeys}"
                                          SelectedItem="{Binding SelectedBackgroundMenu, Mode=TwoWay}"
                                          Style="{StaticResource EliteComboBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Background image path" Style="{StaticResource HeadingSmall}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedMenuBackgroundPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Content="Browse"
                                            Command="{Binding BrowseMenuBackgroundCommand}"
                                            Style="{StaticResource GhostButton}"/>
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Content="Clear"
                                            Command="{Binding ClearMenuBackgroundCommand}"
                                            Style="{StaticResource GhostButton}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Dim light: "/><Run Text="{Binding BackgroundDimStrength, StringFormat={}{0:0.00}}"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="0.5" Value="{Binding BackgroundDimStrength, Mode=TwoWay}"/>

                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Contrast: "/><Run Text="{Binding BackgroundContrastIntensity, StringFormat={}{0:0.00}}"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="0.5" Value="{Binding BackgroundContrastIntensity, Mode=TwoWay}"/>

                            <Button Content="Save Menu Background Settings"
                                    Margin="0,14,0,0"
                                    Command="{Binding SaveMenuBackgroundCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowDatabaseSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Database"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="PostgreSQL-only runtime. Password is stored with Windows DPAPI (CurrentUser). Prefer ELITE_POSTGRES_CONNECTION for services or automation."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12"/>

                            <StackPanel>
                                <TextBlock Text="Provider" Style="{StaticResource HeadingSmall}"/>
                                <ComboBox ItemsSource="{Binding DatabaseProviders}"
                                          SelectedItem="{Binding DatabaseProvider, Mode=TwoWay}"
                                          Style="{StaticResource EliteComboBox}"/>
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Host" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabaseHost, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock Text="Port" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabasePort, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Database name" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Username" Style="{StaticResource HeadingSmall}"/>
                                <TextBox Text="{Binding DatabaseUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource HeadingSmall}">
                                    <Run Text="Password"/>
                                    <Run Text=" (not shown after save)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </TextBlock>
                                <PasswordBox x:Name="DatabasePasswordBox"
                                             Style="{StaticResource ElitePasswordBox}"
                                             PasswordChanged="DatabasePasswordBox_OnPasswordChanged"/>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Visibility="{Binding HasSavedDatabasePassword, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="A password is already saved on this PC. Enter a new password only to change it."/>
                            </StackPanel>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Test Connection"
                                        Margin="0,0,6,0"
                                        Command="{Binding TestDatabaseConnectionCommand}"
                                        Style="{StaticResource GhostButton}"/>
                                <Button Grid.Column="1"
                                        Content="Save Database Settings"
                                        Margin="6,0,0,0"
                                        Command="{Binding SaveDatabaseSettingsCommand}"
                                        Style="{StaticResource GoldPrimaryButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18"
                            Visibility="{Binding ShowAppearanceSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Appearance"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Use HSL picker, then apply the token. No live preview panel."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Height="120"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Background="{Binding PickerPreviewBrush}"/>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <ComboBox SelectedValuePath="Content"
                                              SelectedValue="{Binding SelectedToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource EliteComboBox}">
                                        <ComboBoxItem Content="Background Dark"/>
                                        <ComboBoxItem Content="Background Medium"/>
                                        <ComboBoxItem Content="Sidebar"/>
                                        <ComboBoxItem Content="Card Base"/>
                                        <ComboBoxItem Content="Gold Accent"/>
                                        <ComboBoxItem Content="Text Secondary"/>
                                        <ComboBoxItem Content="Border Subtle"/>
                                        <ComboBoxItem Content="Stat Blue"/>
                                        <ComboBoxItem Content="Stat Green"/>
                                        <ComboBoxItem Content="Stat Red"/>
                                    </ComboBox>

                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Hue: "/><Run Text="{Binding PickerHue, StringFormat={}{0:0}}"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="360" Value="{Binding PickerHue, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Saturation: "/><Run Text="{Binding PickerSaturation, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerSaturation, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Lightness: "/><Run Text="{Binding PickerLightness, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerLightness, Mode=TwoWay}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding PickerHex}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="Apply to selected token"
                                                Width="190"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Command="{Binding ApplyPickerToTokenCommand}"
                                                Style="{StaticResource GoldPrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Button Content="Apply Theme" Margin="0,12,0,0" Command="{Binding ApplyThemeCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Save Theme" Margin="0,0,6,0" Command="{Binding SaveThemeCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                                <Button Grid.Column="1" Content="Reset Default Theme" Margin="6,0,0,0" Command="{Binding ResetThemeCommand}" Style="{StaticResource GhostButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="4,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
