<UserControl x:Class="EliteRestaurantPro.Views.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,18">
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                    <Run Text="Appearance"/>
                    <Run Text=" Settings" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <TextBlock Text="Customize theme colors. Changes can be previewed instantly, then saved for next app launch."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Color Picker (HSL)"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Pick visually with sliders, then apply to a token."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,4,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Height="120"
                                        CornerRadius="10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Background="{Binding PickerPreviewBrush}"/>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <ComboBox SelectedValuePath="Content"
                                              SelectedValue="{Binding SelectedToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource EliteComboBox}">
                                        <ComboBoxItem Content="Background Dark"/>
                                        <ComboBoxItem Content="Background Medium"/>
                                        <ComboBoxItem Content="Card Base"/>
                                        <ComboBoxItem Content="Gold Accent"/>
                                        <ComboBoxItem Content="Text Secondary"/>
                                        <ComboBoxItem Content="Border Subtle"/>
                                        <ComboBoxItem Content="Stat Blue"/>
                                        <ComboBoxItem Content="Stat Green"/>
                                        <ComboBoxItem Content="Stat Red"/>
                                    </ComboBox>

                                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Hue: "/><Run Text="{Binding PickerHue, StringFormat={}{0:0}}"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="360" Value="{Binding PickerHue, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Saturation: "/><Run Text="{Binding PickerSaturation, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerSaturation, Mode=TwoWay}"/>

                                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Lightness: "/><Run Text="{Binding PickerLightness, StringFormat={}{0:0}}"/><Run Text="%"/>
                                    </TextBlock>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding PickerLightness, Mode=TwoWay}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding PickerHex}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="Apply to selected token"
                                                Width="190"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Command="{Binding ApplyPickerToTokenCommand}"
                                                Style="{StaticResource GoldPrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Palette Tokens (manual hex edit if needed)"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Background Dark" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding BackgroundDarkHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Background Medium" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding BackgroundMediumHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Card Base" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding CardBaseHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Gold Accent" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding GoldAccentHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Text Secondary" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding TextSecondaryHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                    <TextBlock Text="Border Subtle" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding BorderSubtleHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Stat Blue" Style="{StaticResource HeadingSmall}"/>
                                    <TextBox Text="{Binding StatBlueHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Stat Green / Stat Red" Style="{StaticResource HeadingSmall}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding StatGreenHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                        <TextBox Grid.Column="2" Text="{Binding StatRedHex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Live Preview"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <Border Margin="0,12,0,0" Background="{StaticResource CardBaseBrush}" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Preview Card Title"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Secondary text sample for readability."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"/>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock Text="Blue info" Foreground="{StaticResource StatBlueBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Green success" Foreground="{StaticResource StatGreenBrush}" Margin="0,0,14,0"/>
                                        <TextBlock Text="Red warning" Foreground="{StaticResource StatRedBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,12,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Apply"
                                        Margin="0,0,6,0"
                                        Command="{Binding ApplyThemeCommand}"
                                        Style="{StaticResource GoldPrimaryButton}"/>
                                <Button Grid.Column="1"
                                        Content="Save"
                                        Margin="6,0,6,0"
                                        Command="{Binding SaveThemeCommand}"
                                        Style="{StaticResource GoldPrimaryButton}"/>
                                <Button Grid.Column="2"
                                        Content="Reload Current"
                                        Margin="6,0,6,0"
                                        Command="{Binding ReloadSavedThemeCommand}"
                                        Style="{StaticResource GhostButton}"/>
                                <Button Grid.Column="3"
                                        Content="Reset Default"
                                        Margin="6,0,0,0"
                                        Command="{Binding ResetThemeCommand}"
                                        Style="{StaticResource GhostButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
