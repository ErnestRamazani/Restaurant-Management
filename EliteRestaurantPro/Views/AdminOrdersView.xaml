<UserControl x:Class="EliteRestaurantPro.Views.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource EliteScrollViewer}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,12">
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                    <Run Text="{Binding PageTitleOrder, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text="{Binding PageTitleAccent, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <TextBlock Text="{Binding PageSubtitle}"
                           Style="{StaticResource BodyText}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="32,0,32,12" Padding="14,10" CornerRadius="10"
                    Background="#3327AE60"
                    Visibility="{Binding ReadyPickupBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ReadyPickupBannerText}"
                           Foreground="#FFB2DFDB" FontSize="13" TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="2" Margin="32,0,32,14" Style="{StaticResource GlassCard}" Padding="14"
                    Visibility="{Binding ShowPendingCashierSection, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding PendingCashierSectionTitle}"
                               Foreground="{StaticResource GoldAccentBrush}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PendingCashierHint}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding PendingCashierOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="10" Padding="12,10" Background="{StaticResource CardBaseBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderCode}" Foreground="{StaticResource GoldAccentBrush}"
                                                       FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding DisplayTableLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding DisplayServerLine}" Foreground="{StaticResource StatBlueBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DisplayCreatedAtText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding LinesSummary}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GrandTotalText}" Foreground="{StaticResource GoldAccentBrush}" FontSize="16" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Content="{Binding DataContext.OrdViewOrderLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,8"
                                                    Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SapphireButton}"/>
                                            <Button Content="{Binding DataContext.OrdReleaseKitchenLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,8"
                                                    Command="{Binding DataContext.ReleasePendingCashierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GoldPrimaryButton}"/>
                                            <Button Content="{Binding DataContext.OrdCancelTicketLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.CancelPendingCashierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="18,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#33FF9800" Offset="0"/>
                                    <GradientStop Color="#11FF9800" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource StatOrangeBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding DataContext.OrdActiveOrdersLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{StaticResource StatOrangeBrush}" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="{Binding ActiveOrders.Count}" Foreground="White"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Margin="12,0,12,8"
                                 Padding="10,8"
                                 Text="{Binding ActiveOrdersSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"
                                 ToolTip="{Binding OrdSearchActiveTooltip}"/>

                        <Border Grid.Row="2" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding ActiveOrders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,12"
                                                Background="{StaticResource CardBaseBrush}">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding OrderId}"
                                                                   Foreground="{StaticResource GoldAccentBrush}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="12" Margin="0,2,0,0"
                                                                   Visibility="{Binding ShowConfirmationCode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Run Text="{Binding DisplayConfirmationLine, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Background="{Binding StatusColor}"
                                                            CornerRadius="6" Padding="7,3" Opacity="0.9">
                                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="White"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                   FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayTableLabel}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="12" Margin="0,5,0,4"/>
                                                <TextBlock Text="{Binding DisplayServerLine}"
                                                           Foreground="{StaticResource StatBlueBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Items}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="34"/>

                                                <Button Margin="0,12,0,0"
                                                        Content="{Binding DataContext.OrdViewOrderLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SapphireButton}"/>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Margin="0,0,6,0"
                                                            Content="{Binding DataContext.OrdAdvanceLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.AdvanceOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SapphireButton}"
                                                            Visibility="{Binding ShowAdvanceInOrders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,6,0"
                                                            Content="{Binding DataContext.OrdCompleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GoldPrimaryButton}"
                                                            Visibility="{Binding ShowCompleteInOrders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    <Button Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            Content="{Binding DataContext.OrdCancelLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButton}"/>
                                                </Grid>
                                                <Button Margin="0,8,0,0"
                                                        Content="{Binding DataContext.OrdViewTicketLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.PrintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Visibility="{Binding ShowViewTicketInOrders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="18,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#334CAF50" Offset="0"/>
                                    <GradientStop Color="#114CAF50" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource StatGreenBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding DataContext.OrdPastOrdersLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{StaticResource StatGreenBrush}" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="{Binding PastOrders.Count}" Foreground="White"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Margin="12,0,12,8"
                                 Padding="10,8"
                                 Text="{Binding PastOrdersSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"
                                 ToolTip="{Binding OrdSearchPastTooltip}"/>

                        <Border Grid.Row="2" Padding="12,8">
                            <ItemsControl ItemsSource="{Binding PastOrderDayGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,10"
                                                  IsExpanded="{Binding IsExpanded}">
                                            <Expander.Header>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{Binding DayText}"
                                                               Foreground="{StaticResource GoldAccentBrush}"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding OrdersCountText}"
                                                               Margin="8,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"/>
                                                </DockPanel>
                                            </Expander.Header>

                                            <ItemsControl ItemsSource="{Binding Orders}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,12"
                                                                Background="{StaticResource CardBaseBrush}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding OrderId}"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                   FontSize="13" FontWeight="SemiBold"/>
                                                                        <TextBlock Margin="10,0,0,0"
                                                                                   Foreground="{StaticResource GoldAccentBrush}"
                                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                   FontSize="13" FontWeight="SemiBold">
                                                                            <Run Text="$ "/><Run Text="{Binding Total, StringFormat=N2}"/>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            Background="{Binding StatusColor}"
                                                                            CornerRadius="6" Padding="7,3" Opacity="0.9">
                                                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="White"
                                                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                   FontSize="10" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Grid Margin="0,5,0,4">
                                                                    <TextBlock Text="{Binding DisplayTableLabel}"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"/>
                                                                    <TextBlock Text="{Binding DisplayTime}" HorizontalAlignment="Right"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding DisplayServerLine}"
                                                                           Foreground="{StaticResource StatBlueBrush}"
                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                           FontSize="11" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding Items}"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                           FontSize="11" TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                                                <Button Margin="0,8,0,0"
                                                                        Content="{Binding DataContext.OrdViewTicketLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Command="{Binding DataContext.PrintTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Visibility="{Binding ShowViewTicketInOrders, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

                </Grid>
            </ScrollViewer>

            <components:OrderDetailPanelView Grid.Row="0" Grid.RowSpan="1"
                                             Panel.ZIndex="5"
                                             DataContext="{Binding OrderDetail}"/>

            <Grid Grid.Row="0" Grid.RowSpan="1"
                  Panel.ZIndex="4"
                  Background="#AA05070F"
                  Visibility="{Binding IsTicketPreviewOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520"
                        CornerRadius="18"
                        BorderBrush="#66D4AF37"
                        BorderThickness="1"
                        Background="#C0151B2D"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding TicketRestaurantName}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding TicketShowConfirmationCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding TicketConfirmationCode, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           FontFamily="Consolas, Courier New"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="{Binding TicketConfirmationCodeLabel, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="{Binding TicketDateLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDateText, Mode=OneWay}"/>
                                <Run Text="    "/><Run Text="{Binding TicketTimeLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketTimeText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding TicketOrderLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketOrderId}"/>
                                <Run Text="    "/><Run Text="{Binding TicketStatusLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDisplayStatus, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                       Text="{Binding TicketDisplayLocationLine, Mode=OneWay}"/>
                            <StackPanel Margin="0,6,0,0"
                                        Visibility="{Binding TicketShowDeliverySection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding TicketFulfillmentSectionTitle, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding TicketShowDeliveryCustomerName, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{Binding TicketCustomerLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDeliveryCustomerName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding TicketPhoneLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDeliveryPhone, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           Visibility="{Binding TicketShowDeliveryAddress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{Binding TicketAddressLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDeliveryAddress, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding TicketShowDeliveryInstructions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{Binding TicketNotesLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDeliveryInstructions, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"
                                       Visibility="{Binding TicketShowServer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="{Binding TicketServerLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketServer}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2">
                                <Run Text="{Binding TicketEquivalentFcLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketEquivalentFcText}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" FontSize="11"
                                       Text="{Binding TicketPaidBreakdownText}"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" FontSize="11"
                                       Text="{Binding TicketChangeBreakdownText}"/>
                            <Separator Background="#55D4AF37"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TicketQtyHeader, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding TicketItemHeader, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding TicketUnitPriceHeader, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{Binding TicketTotalHeader, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" Height="220" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                                <ItemsControl ItemsSource="{Binding TicketLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="95"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Quantity}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayUnitPrice}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding DisplayLineTotal}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Separator Background="#55D4AF37"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0">
                                    <Run Text="{Binding TicketSubtotalLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDisplaySubtotal, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="#E57373" Margin="0,2,0,0"
                                           Text="{Binding TicketDiscountLineText}"
                                           Visibility="{Binding TicketShowDiscount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding TicketTaxLabel}"/><Run Text=": $ "/><Run Text="{Binding TicketTaxAmount, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding TicketServiceLabel}"/><Run Text=": $ "/><Run Text="{Binding TicketServiceAmount, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding TicketShowDeliveryFee, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{Binding TicketDeliveryLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDeliveryFeeUsd, StringFormat=$ {0:N2}}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource GoldAccentBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <Run Text="{Binding TicketGrandTotalUsdLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketDisplayGrandTotal, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding TicketEquivalentFcLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TicketEquivalentFcText}"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" FontSize="11"
                                           Text="{Binding TicketPaidBreakdownText}"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" FontSize="11"
                                           Text="{Binding TicketChangeBreakdownText}"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                                           Text="{Binding TicketDisplayVerification, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding TicketCloseLabel, Mode=OneWay}"
                                    Margin="0,0,6,0"
                                    Command="{Binding CloseTicketPreviewCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding TicketPrintClientLabel, Mode=OneWay}"
                                    Margin="6,0,6,0"
                                    Command="{Binding ExportClientTicketPdfCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="2"
                                    Content="{Binding TicketPrintPaymentLabel, Mode=OneWay}"
                                    Margin="6,0,0,0"
                                    Command="{Binding ExportTicketPdfCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.RowSpan="1"
                  Panel.ZIndex="6"
                  Background="#AA05070F"
                  Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="760"
                        CornerRadius="18"
                        BorderBrush="#66D4AF37"
                        BorderThickness="1"
                        Background="#C0151B2D"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding OrdPayTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding OrdPayOrderLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding PendingCompleteOrderCode, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding OrdPayAmountDueLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding PaymentDueUsd, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                <Run Text="  ("/><Run Text="{Binding PaymentDueFc, Mode=OneWay, StringFormat=FC {0:N0}}"/><Run Text=")"/>
                            </TextBlock>
                            <Separator Margin="0,10,0,8" Background="#55D4AF37"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OrdPayUsdFcLabel, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBox Text="{Binding PaidUsdInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}" Height="42"/>
                                        <Button Content="{Binding OrdPayEditPaidUsdLabel, Mode=OneWay}" Margin="0,6,0,0" Command="{Binding SelectNumpadTargetCommand}" CommandParameter="PaidUsd" Style="{StaticResource GhostButton}"/>
                                        <TextBox Text="{Binding PaidFcInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}" Height="42" Margin="0,8,0,0"/>
                                        <Button Content="{Binding OrdPayEditPaidFcLabel, Mode=OneWay}" Margin="0,6,0,0" Command="{Binding SelectNumpadTargetCommand}" CommandParameter="PaidFc" Style="{StaticResource GhostButton}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="10" CornerRadius="8" Background="#18FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrdPayDueLabel, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                                                       Text="{Binding PaymentDueUsd, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="17" FontWeight="SemiBold"
                                                       Text="{Binding PaymentDueFc, Mode=OneWay, StringFormat=FC {0:N0}}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Margin="4,0" Padding="10" CornerRadius="8" Background="#18FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrdPayRemainingLabel, Mode=OneWay}" Foreground="{StaticResource StatBlueBrush}" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                                                       Text="{Binding RemainingUsd, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="17" FontWeight="SemiBold"
                                                       Text="{Binding RemainingUsdInFc, Mode=OneWay, StringFormat=FC {0:N0}}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Margin="8,0,0,0" Padding="10" CornerRadius="8" Background="#18FFFFFF">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrdPayChangeLabel, Mode=OneWay}" Foreground="{StaticResource StatGreenBrush}" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                                                       Text="{Binding ChangeUsd, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="17" FontWeight="SemiBold"
                                                       Text="{Binding ChangeUsdInFc, Mode=OneWay, StringFormat=FC {0:N0}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           Text="{Binding OrdPayNumpadHint, Mode=OneWay}"/>
                            </Grid>

                            <UniformGrid Grid.Column="1" Columns="3" Rows="4" Margin="16,0,0,0">
                                <Button Content="7" Command="{Binding NumpadDigitCommand}" CommandParameter="7" Style="{StaticResource SapphireButton}"/>
                                <Button Content="8" Command="{Binding NumpadDigitCommand}" CommandParameter="8" Style="{StaticResource SapphireButton}"/>
                                <Button Content="9" Command="{Binding NumpadDigitCommand}" CommandParameter="9" Style="{StaticResource SapphireButton}"/>
                                <Button Content="4" Command="{Binding NumpadDigitCommand}" CommandParameter="4" Style="{StaticResource SapphireButton}"/>
                                <Button Content="5" Command="{Binding NumpadDigitCommand}" CommandParameter="5" Style="{StaticResource SapphireButton}"/>
                                <Button Content="6" Command="{Binding NumpadDigitCommand}" CommandParameter="6" Style="{StaticResource SapphireButton}"/>
                                <Button Content="1" Command="{Binding NumpadDigitCommand}" CommandParameter="1" Style="{StaticResource SapphireButton}"/>
                                <Button Content="2" Command="{Binding NumpadDigitCommand}" CommandParameter="2" Style="{StaticResource SapphireButton}"/>
                                <Button Content="3" Command="{Binding NumpadDigitCommand}" CommandParameter="3" Style="{StaticResource SapphireButton}"/>
                                <Button Content="." Command="{Binding NumpadDotCommand}" Style="{StaticResource GhostButton}"/>
                                <Button Content="0" Command="{Binding NumpadDigitCommand}" CommandParameter="0" Style="{StaticResource SapphireButton}"/>
                                <Button Content="⌫" Command="{Binding NumpadBackspaceCommand}" Style="{StaticResource GhostButton}"/>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding OrdPayCancelLabel, Mode=OneWay}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelPaymentCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding OrdPayGoToChangeLabel, Mode=OneWay}"
                                    Margin="8,0,0,0"
                                    Command="{Binding GoToChangeCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="0" Grid.RowSpan="1"
                  Panel.ZIndex="7"
                  Background="#AA05070F"
                  Visibility="{Binding IsChangeModalOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="760"
                        CornerRadius="18"
                        BorderBrush="#66D4AF37"
                        BorderThickness="1"
                        Background="#C0151B2D"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding OrdChangeTitle, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding OrdChangeOrderLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding PendingCompleteOrderCode, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding OrdChangeRequiredLabel, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ChangeUsd, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                <Run Text="  ("/><Run Text="{Binding ChangeUsdInFc, Mode=OneWay, StringFormat=FC {0:N0}}"/><Run Text=")"/>
                            </TextBlock>
                            <Separator Margin="0,10,0,8" Background="#55D4AF37"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="10" Background="#18FFFFFF" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding OrdChangeAllocateLabel, Mode=OneWay}"
                                               Foreground="{StaticResource GoldAccentBrush}"
                                               FontSize="20"
                                               FontWeight="Bold"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding OrdChangeUsdLabel, Mode=OneWay}"
                                                   Style="{StaticResource HeadingSmall}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   Text="{Binding ChangeUsd, Mode=OneWay, StringFormat=Due $ {0:N2}}"/>
                                        <TextBox Grid.Column="2" Height="42"
                                                 Text="{Binding ChangeUsdInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"/>
                                    </Grid>

                                    <Button Content="{Binding OrdChangeEditUsdLabel, Mode=OneWay}" Margin="0,6,0,0" HorizontalAlignment="Right" Width="170"
                                            Command="{Binding SelectNumpadTargetCommand}" CommandParameter="ChangeUsd"
                                            Style="{StaticResource GhostButton}"/>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding OrdChangeFcLabel, Mode=OneWay}"
                                                   Style="{StaticResource HeadingSmall}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   Text="{Binding ChangeUsdInFc, Mode=OneWay, StringFormat=Due FC {0:N0}}"/>
                                        <TextBox Grid.Column="2" Height="42"
                                                 Text="{Binding ChangeFcInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EliteTextBox}"/>
                                    </Grid>

                                    <Button Content="{Binding OrdChangeEditFcLabel, Mode=OneWay}" Margin="0,6,0,0" HorizontalAlignment="Right" Width="170"
                                            Command="{Binding SelectNumpadTargetCommand}" CommandParameter="ChangeFc"
                                            Style="{StaticResource GhostButton}"/>

                                    <Border Margin="0,14,0,0" Padding="10" CornerRadius="8" Background="#1FFFFFFF">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource StatBlueBrush}" FontWeight="Bold" FontSize="18">
                                                <Run Text="{Binding OrdChangeRemainingAllocateLabel, Mode=OneWay}"/><Run Text=" "/>
                                                <Run Text="{Binding RemainingChangeUsdToAllocate, Mode=OneWay, StringFormat=$ {0:N2}}"/>
                                            </TextBlock>
                                            <TextBlock Margin="0,2,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       Text="{Binding RemainingChangeFcToAllocate, Mode=OneWay, StringFormat=FC {0:N0}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <UniformGrid Grid.Column="1" Columns="3" Rows="4" Margin="16,0,0,0">
                                <Button Content="7" Command="{Binding NumpadDigitCommand}" CommandParameter="7" Style="{StaticResource SapphireButton}"/>
                                <Button Content="8" Command="{Binding NumpadDigitCommand}" CommandParameter="8" Style="{StaticResource SapphireButton}"/>
                                <Button Content="9" Command="{Binding NumpadDigitCommand}" CommandParameter="9" Style="{StaticResource SapphireButton}"/>
                                <Button Content="4" Command="{Binding NumpadDigitCommand}" CommandParameter="4" Style="{StaticResource SapphireButton}"/>
                                <Button Content="5" Command="{Binding NumpadDigitCommand}" CommandParameter="5" Style="{StaticResource SapphireButton}"/>
                                <Button Content="6" Command="{Binding NumpadDigitCommand}" CommandParameter="6" Style="{StaticResource SapphireButton}"/>
                                <Button Content="1" Command="{Binding NumpadDigitCommand}" CommandParameter="1" Style="{StaticResource SapphireButton}"/>
                                <Button Content="2" Command="{Binding NumpadDigitCommand}" CommandParameter="2" Style="{StaticResource SapphireButton}"/>
                                <Button Content="3" Command="{Binding NumpadDigitCommand}" CommandParameter="3" Style="{StaticResource SapphireButton}"/>
                                <Button Content="." Command="{Binding NumpadDotCommand}" Style="{StaticResource GhostButton}"/>
                                <Button Content="0" Command="{Binding NumpadDigitCommand}" CommandParameter="0" Style="{StaticResource SapphireButton}"/>
                                <Button Content="⌫" Command="{Binding NumpadBackspaceCommand}" Style="{StaticResource GhostButton}"/>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding OrdPayCancelLabel, Mode=OneWay}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelChangeCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding OrdChangeConfirmCompleteLabel, Mode=OneWay}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ConfirmChangeCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="#70000000"
                    CornerRadius="10"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding OrdLoadingLabel, Mode=OneWay}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
