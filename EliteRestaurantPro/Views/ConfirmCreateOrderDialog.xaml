<Window x:Class="EliteRestaurantPro.Views.ConfirmCreateOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm create order"
        Width="520"
        SizeToContent="Height"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="14"
            Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#99000000" Opacity="0.8"/>
        </Border.Effect>
        <Border Style="{StaticResource GlassCard}" Margin="20" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        Padding="0,0,0,6"
                        Cursor="Hand"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleHeading"
                               Style="{StaticResource HeadingMedium}"
                               Text="Confirm create order"/>
                </Border>

                <TextBlock x:Name="QuestionText"
                           Grid.Row="1"
                           Style="{StaticResource BodyText}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <Border Grid.Row="2"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Background="#22000000">
                    <TextBlock x:Name="DetailsText"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="{StaticResource GoldAccentBrush}"
                               FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource HeadingSmall}"
                           Text="Submit this ticket?"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="4" Orientation="Vertical">
                    <Button x:Name="ConfirmButton"
                            Content="Create order"
                            Style="{StaticResource GoldPrimaryButton}"
                            MinWidth="280"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            IsDefault="True"
                            Click="Confirm_Click"/>
                    <Button Content="Cancel"
                            Style="{StaticResource GhostButton}"
                            MinWidth="280"
                            HorizontalAlignment="Stretch"
                            IsCancel="True"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
