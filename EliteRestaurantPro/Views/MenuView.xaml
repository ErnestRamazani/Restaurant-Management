<UserControl x:Class="EliteRestaurantPro.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components"
             xmlns:converters="clr-namespace:EliteRestaurantPro.Converters">
    <UserControl.Resources>
        <converters:ProductToMenuCardPhotoConverter x:Key="ProductToMenuCardPhotoConverter"/>
        <converters:ProductMenuMonogramConverter x:Key="ProductMenuMonogramConverter"/>
        <converters:MenuIngredientCountConverter x:Key="MenuIngredientCountConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="{Binding PageTitle, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PageSubtitle, Mode=OneWay}"
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="140"
                        Content="{Binding AddProductLabel, Mode=OneWay}"
                        Command="{Binding OpenAddDialogCommand}"
                        Style="{StaticResource GoldPrimaryButton}"
                        Visibility="{Binding ShowFullAdminNav, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="24,0,24,24"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          IsEnabled="{Binding IsMainContentEnabled}"
                          Style="{StaticResource EliteScrollViewer}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding MenuTypeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ViewCategoryOptions}"
                                              SelectedItem="{Binding SelectedViewCategoryOption}"
                                              DisplayMemberPath="Label"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding SubmenuTypeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ViewSubCategoryOptions}"
                                              SelectedItem="{Binding SelectedViewSubCategoryOption}"
                                              DisplayMemberPath="Label"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     Margin="0,14,0,0"
                                     Style="{StaticResource EliteTextBox}"
                                     Height="42"
                                     MinHeight="42"
                                     FontSize="13"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding SearchTooltip, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding GroupedProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Foreground="{StaticResource GoldAccentBrush}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"/>

                                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,18">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                                               FontSize="16"
                                                               Text="{Binding Name}"/>

                                                    <ItemsControl ItemsSource="{Binding SubCategories}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <TextBlock Foreground="{StaticResource StatBlueBrush}"
                                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                               FontSize="13"
                                                                               Text="{Binding Name}"/>

                                                                    <ItemsControl ItemsSource="{Binding Products}" Margin="0,8,0,0">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Style="{StaticResource GlassCard}"
                                                                                        Width="290"
                                                                                        Margin="0,0,16,16"
                                                                                        Padding="18">
                                                                                    <StackPanel>
                                                                                        <Border Height="132"
                                                                                                CornerRadius="10"
                                                                                                ClipToBounds="True"
                                                                                                Margin="0,0,0,12"
                                                                                                Background="#1E1E28">
                                                                                            <Grid>
                                                                                                <TextBlock Text="{Binding Converter={StaticResource ProductMenuMonogramConverter}}"
                                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                                                           FontSize="40"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Opacity="0.4"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center"/>
                                                                                                <Image Source="{Binding Converter={StaticResource ProductToMenuCardPhotoConverter}}"
                                                                                                       Stretch="UniformToFill"/>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   Margin="0,2,0,8"
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                                                   FontSize="18"
                                                                                                   TextWrapping="Wrap"/>
                                                                                        <TextBlock Text="{Binding UniqueId}"
                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                   FontFamily="Consolas"
                                                                                                   FontSize="11"/>

                                                                                        <TextBlock Foreground="{StaticResource StatBlueBrush}"
                                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                                                   FontSize="22">
                                                                                            <Run Text="$ "/>
                                                                                            <Run Text="{Binding Price, StringFormat=N2}"/>
                                                                                        </TextBlock>

                                                                                        <Expander Margin="0,10,0,0"
                                                                                                  IsExpanded="False"
                                                                                                  Foreground="{StaticResource TextPrimaryBrush}">
                                                                                            <Expander.Header>
                                                                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                                                           FontSize="12"
                                                                                                           FontWeight="SemiBold"
                                                                                                           Text="{Binding Path=Ingredients.Count, Converter={StaticResource MenuIngredientCountConverter}}"/>
                                                                                            </Expander.Header>
                                                                                            <ScrollViewer MaxHeight="200"
                                                                                                          VerticalScrollBarVisibility="Auto"
                                                                                                          Margin="0,6,0,0">
                                                                                                <ItemsControl ItemsSource="{Binding Ingredients}">
                                                                                                    <ItemsControl.ItemTemplate>
                                                                                                        <DataTemplate>
                                                                                                            <TextBlock FontSize="11"
                                                                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                                                                       Margin="0,0,0,6">
                                                                                                                <Run Text="• "/>
                                                                                                                <Run Text="{Binding InventoryItem.Name}"/>
                                                                                                                <Run Text=" "/>
                                                                                                                <Run Text="{Binding Quantity, StringFormat={}{0:0.##}}"/>
                                                                                                                <Run Text=" "/>
                                                                                                                <Run Text="{Binding InventoryItem.Unit}"/>
                                                                                                            </TextBlock>
                                                                                                        </DataTemplate>
                                                                                                    </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                            </ScrollViewer>
                                                                                        </Expander>

                                                                                        <Grid Margin="0,18,0,0"
                                                                                              Visibility="{Binding DataContext.ShowFullAdminNav, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Button Grid.Column="0"
                                                                                                    Content="{Binding DataContext.DetailsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    Margin="0,0,6,0"
                                                                                                    Command="{Binding DataContext.ShowProductDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    CommandParameter="{Binding .}"
                                                                                                    Style="{StaticResource GhostButton}"/>
                                                                                            <Button Grid.Column="1"
                                                                                                    Content="{Binding DataContext.EditLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    Margin="6,0,6,0"
                                                                                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    CommandParameter="{Binding .}"
                                                                                                    Style="{StaticResource SapphireButton}"/>
                                                                                            <Button Grid.Column="2"
                                                                                                    Content="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    Margin="6,0,0,0"
                                                                                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    CommandParameter="{Binding .}"
                                                                                                    Style="{StaticResource DangerButton}"/>
                                                                                        </Grid>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520"
                        MaxHeight="640">
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle, Mode=OneWay}"
                                   Style="{StaticResource HeadingMedium}"
                                   FontSize="22"/>

                        <StackPanel Visibility="{Binding IsEditorDialogMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding MenuFieldProductNameLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,22,0,8"/>
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EliteTextBox}"/>

                            <TextBlock Text="{Binding MenuFieldSectionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Style="{StaticResource EliteComboBox}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                            <TextBlock Text="{Binding MenuFieldTypeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <ComboBox ItemsSource="{Binding SubCategories}"
                                      SelectedItem="{Binding SelectedSubCategory}"
                                      Style="{StaticResource EliteComboBox}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                            <TextBlock Text="{Binding MenuFieldPriceLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EliteTextBox}"/>

                            <TextBlock Text="{Binding MenuFieldCookingTimeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <TextBlock Text="{Binding MenuFieldCookingTimeHelp, Mode=OneWay}"
                                       Style="{StaticResource BodyText}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PrepMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EliteTextBox}"/>

                            <TextBlock Text="{Binding MenuFieldDescriptionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <TextBox Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EliteTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     MaxLength="350"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"
                                       Text="{Binding DescriptionCharCountRemainingText, Mode=OneWay}"/>

                            <TextBlock Text="{Binding MenuFieldCompositionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,8"/>
                            <TextBox Text="{Binding ProductComposition, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EliteTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="56"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="{Binding MenuFieldProductImageLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ProductImagePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                                <Button Grid.Column="1"
                                        Content="{Binding BrowseLabel, Mode=OneWay}"
                                        Margin="8,0,0,0"
                                        Command="{Binding BrowseProductImageCommand}"
                                        Style="{StaticResource SapphireButton}"/>
                                <Button Grid.Column="2"
                                        Content="{Binding ClearLabel, Mode=OneWay}"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearProductImageCommand}"
                                        Style="{StaticResource GhostButton}"/>
                            </Grid>
                            <Border Style="{StaticResource GlassCard}" Height="148" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Image Source="{Binding EditorImagePreview}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasEditorImagePreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding MenuNoImageSelectedLabel, Mode=OneWay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasNoEditorImagePreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <Expander Margin="0,18,0,0"
                                      IsExpanded="False"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding MenuInventoryIngredientsLabel, Mode=OneWay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Expander.Header>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,8,0,0">
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding InventorySelections}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                                                <Run Text="{Binding Name}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="("/>
                                                                <Run Text="{Binding UniqueId}"/>
                                                                <Run Text=")"/>
                                                            </TextBlock>
                                                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                                <Run Text="{Binding DataContext.MenuStockPrefix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding StockQuantity, StringFormat={}{0:0.##}}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Unit}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="2"
                                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource EliteTextBox}"
                                                                 Height="34"
                                                                 VerticalContentAlignment="Center"
                                                                 HorizontalContentAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDetailsDialogMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DetailsProductName}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,18,0,10"/>

                            <Border Style="{StaticResource GlassCard}" Height="148" Padding="14">
                                <Grid>
                                    <Image Source="{Binding DetailsImagePreview}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasDetailsImagePreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding MenuNoImageAvailableLabel, Mode=OneWay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasNoDetailsImagePreview, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="{Binding MenuFieldProductIdLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="{Binding DetailsUniqueId}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,8">
                                    <TextBlock Text="{Binding MenuFieldPriceLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0">
                                        <Run Text="$ "/>
                                        <Run Text="{Binding DetailsPrice, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="{Binding MenuFieldSectionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="{Binding DetailsCategory}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,8">
                                    <TextBlock Text="{Binding MenuFieldTypeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="{Binding DetailsSubCategory}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="{Binding MenuFieldCookingTimeShortLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="{Binding DetailsPrepMinutes, Mode=OneWay}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="{Binding MenuDetailsDescriptionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,8"/>
                            <Border Style="{StaticResource GlassCard}" Padding="10">
                                <TextBlock Text="{Binding DetailsDescription, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/>
                            </Border>

                            <TextBlock Text="{Binding MenuDetailsCompositionLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,8"/>
                            <Border Style="{StaticResource GlassCard}" Padding="10">
                                <TextBlock Text="{Binding DetailsComposition, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/>
                            </Border>

                            <Expander Margin="0,12,0,0"
                                      IsExpanded="False"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding MenuIngredientsLabel, Mode=OneWay}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Expander.Header>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,8,0,0">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProductIngredientsSummary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="12"
                                                               Margin="0,0,0,6"
                                                               Text="{Binding .}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>

                        <Grid Margin="0,24,0,0" Visibility="{Binding IsEditorDialogMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding CancelLabel, Mode=OneWay}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding MenuSaveProductLabel, Mode=OneWay}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveProductCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>

                        <Button Content="{Binding CloseLabel, Mode=OneWay}"
                                Margin="0,24,0,0"
                                Command="{Binding CancelDialogCommand}"
                                Style="{StaticResource GhostButton}"
                                Visibility="{Binding IsDetailsDialogMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
