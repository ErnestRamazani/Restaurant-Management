<UserControl x:Class="EliteRestaurantPro.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="Menu" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text=" Products" Foreground="{StaticResource GoldAccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Curate the premium product catalog for service and POS."
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="140"
                        Content="Add Product"
                        Command="{Binding OpenAddDialogCommand}"
                        Style="{StaticResource GoldPrimaryButton}"
                        Visibility="{Binding ShowFullAdminNav, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="24,0,24,24"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Style="{StaticResource EliteScrollViewer}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MENU TYPE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ViewCategories}"
                                              SelectedItem="{Binding SelectedViewCategory}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SUBMENU TYPE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ViewSubCategories}"
                                              SelectedItem="{Binding SelectedViewSubCategory}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     Margin="0,14,0,0"
                                     Style="{StaticResource EliteTextBox}"
                                     Height="42"
                                     MinHeight="42"
                                     FontSize="13"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search menu items by name, category, ID, or price"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding GroupedProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,24">
                                    <TextBlock Foreground="{StaticResource GoldAccentBrush}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"/>

                                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,18">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                                               FontSize="16"
                                                               Text="{Binding Name}"/>

                                                    <ItemsControl ItemsSource="{Binding SubCategories}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,14">
                                                                    <TextBlock Foreground="{StaticResource StatBlueBrush}"
                                                                               FontFamily="Segoe UI Variable Text, Segoe UI"
                                                                               FontSize="13"
                                                                               Text="{Binding Name}"/>

                                                                    <ItemsControl ItemsSource="{Binding Products}" Margin="0,8,0,0">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Style="{StaticResource GlassCard}"
                                                                                        Width="290"
                                                                                        Margin="0,0,16,16"
                                                                                        Padding="18">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   Margin="0,2,0,8"
                                                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                                                   FontSize="18"
                                                                                                   TextWrapping="Wrap"/>
                                                                                        <TextBlock Text="{Binding UniqueId}"
                                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                                   FontFamily="Consolas"
                                                                                                   FontSize="11"/>

                                                                                        <TextBlock Foreground="{StaticResource StatBlueBrush}"
                                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                                                                   FontSize="22">
                                                                                            <Run Text="$ "/>
                                                                                            <Run Text="{Binding Price, StringFormat=N2}"/>
                                                                                        </TextBlock>

                                                                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Ingredients}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <TextBlock FontSize="11"
                                                                                                               Foreground="{StaticResource TextMutedBrush}">
                                                                                                        <Run Text="• "/>
                                                                                                        <Run Text="{Binding InventoryItem.Name}"/>
                                                                                                        <Run Text=" "/>
                                                                                                        <Run Text="{Binding Quantity, StringFormat={}{0:0.##}}"/>
                                                                                                        <Run Text=" "/>
                                                                                                        <Run Text="{Binding InventoryItem.Unit}"/>
                                                                                                    </TextBlock>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>

                                                                                        <Grid Margin="0,18,0,0"
                                                                                              Visibility="{Binding DataContext.ShowFullAdminNav, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <Button Grid.Column="0"
                                                                                                    Content="Edit"
                                                                                                    Margin="0,0,8,0"
                                                                                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    Style="{StaticResource SapphireButton}"/>
                                                                                            <Button Grid.Column="1"
                                                                                                    Content="Delete"
                                                                                                    Margin="8,0,0,0"
                                                                                                    Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    Style="{StaticResource DangerButton}"/>
                                                                                        </Grid>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520"
                        MaxHeight="640">
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}"
                                   Style="{StaticResource HeadingMedium}"
                                   FontSize="22"/>

                        <TextBlock Text="PRODUCT NAME" Style="{StaticResource HeadingSmall}" Margin="0,22,0,8"/>
                        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="SECTION" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                        <TextBlock Text="TYPE" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <ComboBox ItemsSource="{Binding SubCategories}"
                                  SelectedItem="{Binding SelectedSubCategory}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                        <TextBlock Text="PRICE" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="DESCRIPTION (CUSTOMER MENU)" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="72"
                                 MaxLength="350"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"
                                   Text="{Binding DescriptionCharCountRemaining, StringFormat=Characters remaining: {0}}"/>

                        <TextBlock Text="COMPOSITION (CUSTOMER, COMMA-SEPARATED)" Style="{StaticResource HeadingSmall}" Margin="0,12,0,8"/>
                        <TextBox Text="{Binding ProductComposition, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="INGREDIENTS FROM INVENTORY"
                                   Style="{StaticResource HeadingSmall}"
                                   Margin="0,18,0,8"/>
                        <Border Style="{StaticResource GlassCard}" Padding="10" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                                <ItemsControl ItemsSource="{Binding InventorySelections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                                        <Run Text="{Binding Name}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="("/>
                                                        <Run Text="{Binding UniqueId}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10">
                                                        <Run Text="Stock: "/>
                                                        <Run Text="{Binding StockQuantity, StringFormat={}{0:0.##}}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Unit}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource EliteTextBox}"
                                                         Height="34"
                                                         VerticalContentAlignment="Center"
                                                         HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="Save Product"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveProductCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
