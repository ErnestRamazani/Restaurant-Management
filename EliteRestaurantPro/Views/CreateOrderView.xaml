<UserControl x:Class="EliteRestaurantPro.Views.CreateOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <UserControl.Resources>
        <!-- Hit target for product row: toggles selection; +/- live in a separate column. -->
        <Style x:Key="CreateOrderProductRowToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A3F1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,20">
                <TextBlock Text="{Binding PageTitle, Mode=OneWay}"
                           Style="{StaticResource HeadingLarge}"
                           FontSize="26"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding PageSubtitle, Mode=OneWay}"
                           Style="{StaticResource BodyText}"
                           FontSize="13"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>

                <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="#3327AE60"
                        Visibility="{Binding ReadyPickupBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ReadyPickupBannerText, Mode=OneWay}"
                               Foreground="#FFB2DFDB" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="8" Background="#334682B4"
                        Visibility="{Binding HasOpenCheckForTable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding OpenCheckBannerText, Mode=OneWay}"
                               Foreground="#FFBBDEFB" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ComboBox Width="280"
                              Margin="0,0,8,8"
                              ItemsSource="{Binding SavedDrafts}"
                              SelectedItem="{Binding SelectedDraft}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource EliteComboBox}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="{Binding LoadDraftLabel, Mode=OneWay}"
                            Command="{Binding LoadDraftCommand}"
                            Style="{StaticResource GoldPrimaryButton}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="{Binding SaveDraftLabel, Mode=OneWay}"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource SapphireButton}"/>
                    <Button Width="84"
                            Margin="0,0,8,8"
                            Content="{Binding RemoveDraftLabel, Mode=OneWay}"
                            Command="{Binding DeleteDraftCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="{Binding RemoveAllDraftsLabel, Mode=OneWay}"
                            Command="{Binding DeleteAllDraftsCommand}"
                            Style="{StaticResource DangerButton}"/>
                    <Button Width="78"
                            Margin="0,0,0,8"
                            Content="{Binding ClearSelectionLabel, Mode=OneWay}"
                            Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource GhostButton}"/>
                </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TableLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableTables}"
                                              SelectedValue="{Binding SelectedTableId}"
                                              SelectedValuePath="Id"
                                              IsEnabled="{Binding CanEditTableForCurrentSource}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="{Binding DataContext.TableComboPrefix, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Run Text="{Binding TableNumber, Mode=OneWay}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" · " Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Run Text="{Binding DisplayStatus, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding MenuTypeLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding OrderCategoryOptions}"
                                              SelectedItem="{Binding SelectedOrderCategoryOption}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SubmenuTypeLabel, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding OrderSubCategoryOptions}"
                                          SelectedItem="{Binding SelectedOrderSubCategoryOption}"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SearchProductLabel, Mode=OneWay}"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </Grid>

                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource EliteScrollViewer}">
                            <ItemsControl ItemsSource="{Binding FilteredProductSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Background="{StaticResource CardBaseBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="Background" Value="#284A3F1D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        IsEnabled="{Binding CanToggleProductRow}"
                                                        Style="{StaticResource CreateOrderProductRowToggleButton}"
                                                        Command="{Binding DataContext.ToggleProductSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding FormattedPrice, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                                                        </TextBlock>
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                            <Run Text="{Binding Category, Mode=OneWay}"/>
                                                            <Run Text=" / "/>
                                                            <Run Text="{Binding SubCategory, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding AvailabilityHint, Mode=OneWay}"
                                                                   Foreground="#FFB06060"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="-"
                                                            IsEnabled="{Binding IsSelected}"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"/>
                                                    <Border Grid.Column="1" Margin="6,0" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Quantity, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="+"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SapphireButton}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding LiveTotalsLabel, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0">
                                <Run Text="{Binding ItemsSelectedLabel, Mode=OneWay}"/>
                                <Run Text="{Binding LiveItemCount, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0">
                                <Run Text="{Binding EstimatedPrepLabel, Mode=OneWay}"/>
                                <Run Text="{Binding EstimatedPrepText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding CustomerNotesLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,10,0,6"/>
                            <TextBox Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource CardBaseBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Padding="8"/>
                            <TextBlock Text="{Binding AllergyNotesLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,8,0,6"/>
                            <TextBox Text="{Binding AllergyNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource CardBaseBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Padding="8"/>

                            <TextBlock Text="{Binding LinkClientLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         ToolTip="{Binding ClientSearchTooltip, Mode=OneWay}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding LinkClientButtonLabel, Mode=OneWay}" Command="{Binding LinkClientCommand}" Style="{StaticResource GhostButton}"/>
                                <Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding ClearClientButtonLabel, Mode=OneWay}" Command="{Binding ClearLinkedClientCommand}" Style="{StaticResource GhostButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding LinkedClientLabel, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="12" Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding DiscountLabel, Mode=OneWay}" Style="{StaticResource HeadingSmall}" Margin="0,12,0,6"/>
                            <TextBlock Text="{Binding DiscountHint, Mode=OneWay}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DiscountModeOptions}"
                                          SelectedItem="{Binding SelectedDiscountModeOption}"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding DiscountInputTooltip, Mode=OneWay}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="{StaticResource CardBaseBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding LiveDiscountSummary, Mode=OneWay}"
                                       Foreground="{StaticResource StatOrangeBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                            <ItemsControl ItemsSource="{Binding SelectedProductSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18000000" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                        <Run Text="{Binding UniqueId, Mode=OneWay}"/>
                                                        <Run Text=" | "/>
                                                        <Run Text="{Binding DataContext.QtyPrefix, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                        <Run Text=" x "/>
                                                        <Run Text="{Binding FormattedPrice, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Grid Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="-"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"/>
                                                    <Border Grid.Column="1" Margin="4,0" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Quantity, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="+"
                                                            IsEnabled="{Binding CanIncreaseQuantity}"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SapphireButton}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="X"
                                                            Width="36"
                                                            Margin="0,0,8,0"
                                                            ToolTip="{Binding DataContext.RemoveLineTooltip, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.RemoveSelectedLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DangerButton}"/>
                                                    <TextBlock Text="{Binding FormattedLineTotal, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{Binding SubtotalLineText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TaxLineText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ServiceLineText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding GrandTotalLineText, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding EquivalentFcLineText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding AmountToCollectLineText, Mode=OneWay}" Foreground="{StaticResource StatBlueBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>

                            <!-- Focusable=false: after a modal dialog closes, Enter can otherwise re-fire this Command from focus snap-back. -->
                            <Button Margin="0,14,0,0"
                                    Focusable="False"
                                    Content="{Binding PrimaryActionLabel, Mode=OneWay}"
                                    Command="{Binding CreateOrderCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="#70000000"
                    CornerRadius="10"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding LoadingOverlayText, Mode=OneWay}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
