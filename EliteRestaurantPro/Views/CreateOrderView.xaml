<UserControl x:Class="EliteRestaurantPro.Views.CreateOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,20">
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource HeadingLarge}"
                           FontSize="26"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding PageSubtitle}"
                           Style="{StaticResource BodyText}"
                           FontSize="13"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>

                <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="#3327AE60"
                        Visibility="{Binding ReadyPickupBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ReadyPickupBannerText}"
                               Foreground="#FFB2DFDB" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="8" Background="#334682B4"
                        Visibility="{Binding HasOpenCheckForTable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding OpenCheckBannerText}"
                               Foreground="#FFBBDEFB" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ComboBox Width="280"
                              Margin="0,0,8,8"
                              ItemsSource="{Binding SavedDrafts}"
                              SelectedItem="{Binding SelectedDraft}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource EliteComboBox}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="Load Draft"
                            Command="{Binding LoadDraftCommand}"
                            Style="{StaticResource GoldPrimaryButton}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="Save Draft"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource SapphireButton}"/>
                    <Button Width="84"
                            Margin="0,0,8,8"
                            Content="Remove"
                            Command="{Binding DeleteDraftCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <Button Width="100"
                            Margin="0,0,8,8"
                            Content="Remove All"
                            Command="{Binding DeleteAllDraftsCommand}"
                            Style="{StaticResource DangerButton}"/>
                    <Button Width="78"
                            Margin="0,0,0,8"
                            Content="Clear"
                            Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource GhostButton}"/>
                </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ORDER SOURCE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding OrderSources}"
                                              SelectedItem="{Binding SelectedOrderSource}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="REFERENCE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding ArrivedReservations}"
                                              SelectedItem="{Binding SelectedArrivedReservation, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              Visibility="{Binding IsReservationSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <ComboBox ItemsSource="{Binding DeliveryReferences}"
                                              Text="{Binding SelectedDeliveryReference, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              Visibility="{Binding IsDeliverySource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBox Text="None"
                                             IsReadOnly="True"
                                             Style="{StaticResource EliteTextBox}"
                                             Visibility="{Binding IsWalkInSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="TABLE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding AvailableTables}"
                                              SelectedValue="{Binding SelectedTableId}"
                                              SelectedValuePath="Id"
                                              IsEnabled="{Binding CanEditTableForCurrentSource}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource EliteComboBox}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeliverySource}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                    <Run Text="Table "/>
                                                    <Run Text="{Binding TableNumber}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text=" · " Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Run Text="{Binding Status}" Foreground="{StaticResource GoldAccentBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Text="None / N-A"
                                             IsReadOnly="True"
                                             Style="{StaticResource EliteTextBox}"
                                             Visibility="{Binding IsDeliverySource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="MENU TYPE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8"/>
                                    <ComboBox ItemsSource="{Binding OrderCategories}"
                                              SelectedItem="{Binding SelectedOrderCategory}"
                                              Style="{StaticResource EliteComboBox}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="SUBMENU TYPE"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding OrderSubCategories}"
                                          SelectedItem="{Binding SelectedOrderSubCategory}"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="SEARCH PRODUCT (NAME / ID)"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="PAYMENT CURRENCY"
                                           Style="{StaticResource HeadingSmall}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PaymentCurrencies}"
                                          SelectedItem="{Binding SelectedPaymentCurrency}"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                            </Grid>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource EliteScrollViewer}">
                            <ItemsControl ItemsSource="{Binding FilteredProductSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBaseBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Price, Mode=OneWay, StringFormat=($ {0:N2})}" Foreground="{StaticResource GoldAccentBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding SubCategory, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0"
                                                            Content="-"
                                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"/>
                                                    <Border Grid.Column="1" Margin="6,0" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Quantity, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="+"
                                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SapphireButton}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Live Totals" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0">
                                <Run Text="Items selected: "/>
                                <Run Text="{Binding LiveItemCount, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0">
                                <Run Text="Estimated prep: "/>
                                <Run Text="{Binding EstimatedPrepText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="CUSTOMER NOTES" Style="{StaticResource HeadingSmall}" Margin="0,10,0,6"/>
                            <TextBox Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource CardBaseBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Padding="8"/>
                            <TextBlock Text="ALLERGY NOTES" Style="{StaticResource HeadingSmall}" Margin="0,8,0,6"/>
                            <TextBox Text="{Binding AllergyNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="62"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Background="{StaticResource CardBaseBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     BorderThickness="1"
                                     Padding="8"/>

                            <TextBlock Text="DISCOUNT" Style="{StaticResource HeadingSmall}" Margin="0,12,0,6"/>
                            <TextBlock Text="Applies to merchandise subtotal before tax &amp; service. FC payment still uses discounted grand total."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding DiscountModes}"
                                          SelectedItem="{Binding SelectedDiscountMode}"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Percent (e.g. 10) or USD amount (e.g. 5.50)"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="{StaticResource CardBaseBrush}"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding LiveDiscountSummary, Mode=OneWay}"
                                       Foreground="{StaticResource StatOrangeBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                            <ItemsControl ItemsSource="{Binding SelectedProductSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18000000" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                                                        <Run Text="{Binding UniqueId, Mode=OneWay}"/><Run Text=" | Qty "/><Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" x $ "/><Run Text="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold">
                                                    <Run Text="$ "/><Run Text="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2">
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="Subtotal (items): $ "/><Run Text="{Binding LiveSubtotal, Mode=OneWay, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding LiveTaxRateLabel, Mode=OneWay}"/><Run Text=": $ "/><Run Text="{Binding LiveTaxAmount, Mode=OneWay, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding LiveServiceRateLabel, Mode=OneWay}"/><Run Text=": $ "/><Run Text="{Binding LiveServiceAmount, Mode=OneWay, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource GoldAccentBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0">
                                <Run Text="Grand Total: "/><Run Text="{Binding LiveGrandTotalUsdText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                <Run Text="Equivalent FC: "/><Run Text="{Binding LiveGrandTotalFcText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource StatBlueBrush}" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="Amount To Collect: "/><Run Text="{Binding ChosenPaymentAmountText, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- Focusable=false: after Win32 MessageBox closes, Enter can otherwise re-fire this Command from focus snap-back. -->
                            <Button Margin="0,14,0,0"
                                    Focusable="False"
                                    Content="{Binding PrimaryActionLabel}"
                                    Command="{Binding CreateOrderCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Background="#70000000"
                    CornerRadius="10"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Loading create order..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
