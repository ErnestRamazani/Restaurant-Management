<UserControl x:Class="EliteRestaurantPro.Views.KitchenOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="Kitchen" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text=" / Bar" Foreground="{StaticResource GoldAccentBrush}"/>
                        <Run Text=" Queue" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Incoming shows Waiting plus online/cashier pending tickets. Release pending orders to prep, receive Waiting into In Kitchen, then mark Ready. Select any ticket for full detail."
                               Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LoadStatusMessage, Mode=OneWay}"
                               Foreground="#FFB74D" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasLoadStatusMessage, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Top" Content="Refresh"
                        Command="{Binding RefreshCommand}" Style="{StaticResource SapphireButton}" Width="100"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" MinHeight="280">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Incoming: Waiting -->
                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,12" CornerRadius="14,14,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#332196F3" Offset="0"/>
                                    <GradientStop Color="#112196F3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Incoming" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"/>
                                <Border Margin="10,0,0,0" Background="{StaticResource StatBlueBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="{Binding IncomingOrders.Count}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding IncomingOrders}"
                                 SelectedItem="{Binding SelectedIncoming}"
                                 BorderThickness="0" Background="Transparent" Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#332196F3"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#222196F3"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,10" Background="#FF1A1A2E">
                                        <StackPanel>
                                            <Border CornerRadius="8" Padding="6,4" Margin="0,0,0,8" HorizontalAlignment="Left" Background="#332196F3">
                                                <TextBlock Text="{Binding FulfillmentHeadline}" Foreground="{StaticResource StatBlueBrush}"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding OrderId}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TableNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ServerName, StringFormat=Server: {0}}" Foreground="{StaticResource StatBlueBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Items}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Total, StringFormat=$ {0:N2}}" Foreground="{StaticResource GoldAccentBrush}" Margin="0,6,0,8"/>
                                            <Button Content="View order" Margin="0,0,0,8"
                                                    Command="{Binding DataContext.ViewFullOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SapphireButton}"/>
                                            <Button Content="Release to kitchen"
                                                    Command="{Binding DataContext.ReleaseToKitchenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowReleaseToKitchen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Receive → In Kitchen"
                                                    Command="{Binding DataContext.StartPreparingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowReceiveInKitchen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Preparing -->
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,12" CornerRadius="14,14,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#33FF9800" Offset="0"/>
                                    <GradientStop Color="#11FF9800" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="In Kitchen (preparing)" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"/>
                                <Border Margin="10,0,0,0" Background="{StaticResource StatOrangeBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="{Binding PreparingOrders.Count}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding PreparingOrders}"
                                 SelectedItem="{Binding SelectedPreparing}"
                                 BorderThickness="0" Background="Transparent" Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#33FF9800"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#22FF9800"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,10" Background="#FF1A1A2E">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderId}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TableNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ServerName, StringFormat=Server: {0}}" Foreground="{StaticResource StatBlueBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Items}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Total, StringFormat=$ {0:N2}}" Foreground="{StaticResource GoldAccentBrush}" Margin="0,6,0,8"/>
                                            <Button Content="View order" Margin="0,0,0,8"
                                                    Command="{Binding DataContext.ViewFullOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SapphireButton}"/>
                                            <Button Content="Ready for pickup"
                                                    Command="{Binding DataContext.MarkReadyForPickupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowMarkReadyForPickup}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Picked up: Ready -->
                <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,12" CornerRadius="14,14,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#334CAF50" Offset="0"/>
                                    <GradientStop Color="#114CAF50" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Picked up (ready)" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"/>
                                <Border Margin="10,0,0,0" Background="{StaticResource StatGreenBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="{Binding ReadyPickupOrders.Count}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ReadyPickupOrders}"
                                 SelectedItem="{Binding SelectedReady}"
                                 BorderThickness="0" Background="Transparent" Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="4">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#334CAF50"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#224CAF50"/>
                                                        <Setter TargetName="Bd" Property="CornerRadius" Value="10"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,10" Background="#FF1A1A2E">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderId}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TableNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ServerName, StringFormat=Server: {0}}" Foreground="{StaticResource StatBlueBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Items}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Total, StringFormat=$ {0:N2}}" Foreground="{StaticResource GoldAccentBrush}" Margin="0,6,0,8"/>
                                            <Button Content="View order"
                                                    Command="{Binding DataContext.ViewFullOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SapphireButton}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </Grid>

                <!-- Detail panel -->
                <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource GlassCard}" Padding="16">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                            <StackPanel Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Order detail" Foreground="{StaticResource GoldAccentBrush}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DetailOrderCode}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding DetailTable}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DetailServer, StringFormat=Server: {0}}" Foreground="{StaticResource StatBlueBrush}" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DetailTime}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding DetailStatus, StringFormat=Status: {0}}" Foreground="{StaticResource StatOrangeBrush}" FontSize="12" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding DetailTotal, StringFormat=Total: {0}}" Foreground="{StaticResource GoldAccentBrush}" FontSize="13" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Release to kitchen"
                                            Command="{Binding DetailReleaseToKitchenCommand}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding ShowDetailReleaseToKitchen, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}"/>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Receive → In Kitchen"
                                            Command="{Binding DetailReceiveInKitchenCommand}"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding ShowDetailReceiveInKitchen, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}"/>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Ready for pickup"
                                            Command="{Binding DetailMarkReadyCommand}"
                                            Visibility="{Binding ShowDetailMarkReady, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}"/>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding DetailActionHint}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Visibility="{Binding HasDetailActionHint, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <TextBlock Text="CUSTOMER NOTES" Style="{StaticResource HeadingSmall}" Margin="0,16,0,6"/>
                                <TextBlock Text="{Binding DetailCustomerNotes}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>

                                <TextBlock Text="ALLERGY NOTES" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                                <TextBlock Text="{Binding DetailAllergyNotes}" Foreground="#FFE57373" FontSize="12" TextWrapping="Wrap"/>

                                <TextBlock Text="LINE ITEMS" Style="{StaticResource HeadingSmall}" Margin="0,16,0,8"/>
                                <ItemsControl ItemsSource="{Binding DetailLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22000000" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0">
                                                            <Run Text="Station: "/>
                                                            <Run Text="{Binding Station}" Foreground="{StaticResource StatBlueBrush}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=x{0}}"
                                                               Foreground="{StaticResource GoldAccentBrush}" FontSize="14" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock Text="Select a ticket from Incoming, In kitchen, or Picked up to view full detail here."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center" TextAlignment="Center" Margin="8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <components:OrderDetailPanelView Grid.Row="0" Grid.RowSpan="2"
                                             Panel.ZIndex="20"
                                             DataContext="{Binding OrderDetail}"/>
        </Grid>
    </Grid>
</UserControl>
