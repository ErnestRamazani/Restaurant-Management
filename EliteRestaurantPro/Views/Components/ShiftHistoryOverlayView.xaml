<UserControl x:Class="EliteRestaurantPro.Views.Components.ShiftHistoryOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ShiftHistoryGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1C2238"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#553A415E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="ShiftHistoryGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF131A2B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1C2642"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShiftHistoryCellWrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsShiftHistoryOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button Command="{Binding CloseShiftHistoryCommand}"
                Background="#88070A13"
                BorderThickness="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Style="{StaticResource DialogCard}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="960"
                MaxHeight="640"
                Margin="24"
                Panel.ZIndex="1">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,16,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ShiftHistoryTitle}"
                                   Style="{StaticResource HeadingMedium}"
                                   FontSize="20"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ShiftHistorySubtitle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding ShiftHistoryCloseLabel}"
                            Command="{Binding CloseShiftHistoryCommand}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="88"
                            VerticalAlignment="Top"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding ShiftHistoryBanner}"
                           Margin="18,10,18,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource GoldAccentBrush}"
                           FontSize="13"
                           Visibility="{Binding ShiftHistoryBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <DataGrid x:Name="ShiftHistoryGrid"
                          Grid.Row="2"
                          Margin="14,12,14,14"
                          ItemsSource="{Binding ShiftHistoryRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          ColumnHeaderStyle="{StaticResource ShiftHistoryGridHeader}"
                          RowStyle="{StaticResource ShiftHistoryGridRow}"
                          Background="#FF131A2B"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="#2BFFFFFF"
                          RowBackground="#FF131A2B"
                          AlternatingRowBackground="#FF1A2235"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#223A415E"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MinHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding WorkDateDisplay}" Width="128" MinWidth="110"/>
                        <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="108" MinWidth="88"/>
                        <DataGridTextColumn Header="In" Binding="{Binding ClockIn}" Width="56" MinWidth="48"/>
                        <DataGridTextColumn Header="Out" Binding="{Binding ClockOut}" Width="56" MinWidth="48"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ShiftHistoryCellWrap}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Justification" Binding="{Binding Justification}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ShiftHistoryCellWrap}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ShiftHistoryCellWrap}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3"
                           Margin="18,0,18,14"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="{Binding ShiftHistoryDismissHint}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
