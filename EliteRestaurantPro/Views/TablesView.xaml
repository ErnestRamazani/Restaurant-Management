<UserControl x:Class="EliteRestaurantPro.Views.TablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="Table" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text=" Management" Foreground="{StaticResource GoldAccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Manage dining capacity and live availability status."
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1"
                        Width="120"
                        Content="Add Table"
                        Command="{Binding OpenAddDialogCommand}"
                        Style="{StaticResource GoldPrimaryButton}"
                        Visibility="{Binding ShowTableManagementChrome, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="0,16,0,0"
                         Style="{StaticResource EliteTextBox}"
                         Height="42"
                         MinHeight="42"
                         FontSize="13"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by table number, name, ID, capacity, status, or server"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="24,0,24,24"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource EliteScrollViewer}">
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="18">
                                            <Run Text="Table ID "/>
                                            <Run Text="{Binding TableNumber}" Foreground="{StaticResource GoldAccentBrush}"/>
                                            <Run Text="  ·  "/>
                                            <Run Text="{Binding Name}"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#152196F3" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Capacity, StringFormat=Capacity {0}}"
                                                           Foreground="{StaticResource StatBlueBrush}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"/>
                                            </Border>
                                            <Border CornerRadius="8" Padding="10,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#224CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                                <Setter Property="Background" Value="#22F44336"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                                <Setter Property="Background" Value="#22FF9800"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource StatGreenBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatRedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatOrangeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#22D4AF37" CornerRadius="8" Padding="10,4" Margin="8,0,0,0">
                                                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI"
                                                           FontSize="11"
                                                           Foreground="{StaticResource GoldAccentBrush}">
                                                    <Run Text="Server: "/>
                                                    <Run Text="{Binding AssignedServer.Name, TargetNullValue=Unassigned}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="90"
                                            Margin="12,0,10,0"
                                            Content="Edit"
                                            Command="{Binding DataContext.EditTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SapphireButton}"
                                            Visibility="{Binding DataContext.ShowTableManagementChrome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <Button Grid.Column="2"
                                            Width="90"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButton}"
                                            Visibility="{Binding DataContext.ShowTableManagementChrome, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="440">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}"
                                   Style="{StaticResource HeadingMedium}"
                                   FontSize="22"/>

                        <TextBlock Text="TABLE NUMBER" Style="{StaticResource HeadingSmall}" Margin="0,22,0,8"/>
                        <TextBox Text="{Binding TableNumberText, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Style="{StaticResource EliteTextBox}"/>
                        <TextBlock Text="For new tables, ID is assigned automatically."
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"/>

                        <TextBlock Text="TABLE NAME" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding TableNameText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="CAPACITY" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <TextBox Text="{Binding CapacityText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="STATUS" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                        <TextBlock Text="ASSIGNED SERVER" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                        <ComboBox ItemsSource="{Binding Servers}"
                                  SelectedValue="{Binding SelectedServerId}"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="Save Table"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveTableCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
