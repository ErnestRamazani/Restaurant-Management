<UserControl x:Class="EliteRestaurantPro.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components"
             DataContextChanged="EmployeesView_OnDataContextChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource HeadingLarge}" FontSize="26"/>
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="1"
                        Width="170"
                        Content="{Binding AddNewEmployeeLabel}"
                        Command="{Binding OpenAddDialogCommand}"
                        Style="{StaticResource GoldPrimaryButton}"/>

                <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                         Margin="0,16,0,0"
                         Style="{StaticResource EliteTextBox}"
                         Height="42"
                         MinHeight="42"
                         FontSize="13"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SearchTooltip}"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="24,0,24,24"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource EliteScrollViewer}">
                <ItemsControl ItemsSource="{Binding Employees}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="0">
                                <Expander Background="Transparent" BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Margin="18,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Border Background="#22D4AF37" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayRole}" Foreground="{StaticResource GoldAccentBrush}" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#152196F3" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DataContext.PinMaskedLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource StatBlueBrush}" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#331E88E5" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SignInId, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DisplaySignInBadge}" Foreground="#FF64B5F6" FontSize="11"/>
                                                    </Border>
                                                    <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,4">
                                                        <TextBlock Text="{Binding DisplayEmploymentStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="▼"
                                                       Foreground="{StaticResource GoldAccentBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Expander.Header>

                                    <Grid Margin="18,0,18,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Border Width="160" Height="180" CornerRadius="12" BorderBrush="#55D4AF37" BorderThickness="1">
                                                <Grid>
                                                    <Image Source="{Binding ProfileImagePath}" Stretch="UniformToFill"/>
                                                    <Border Background="#55070A13">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProfileImagePath, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource GoldAccentBrush}"
                                                               FontSize="42"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProfileImagePath, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding DataContext.NotesLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                                            <Border Background="#22000000" CornerRadius="10" Padding="10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <ScrollViewer Height="120" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                                                    <TextBlock Text="{Binding DisplayNotesForView}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding DataContext.ProfileTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayPhoneText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayMonthlySalaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="{Binding DataContext.SystemIdLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                        <Run Text="{Binding UniqueId, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="{Binding DataContext.EmpSignInIdLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                        <Run Text="{Binding SignInId, Mode=OneWay, TargetNullValue=—}" Foreground="{StaticResource GoldAccentBrush}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayJoinedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayTenureText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding DataContext.PerformanceTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                            <WrapPanel>
                                                <Border Background="#152196F3" CornerRadius="10" Padding="14,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayOrdersServedText}" Foreground="{StaticResource StatBlueBrush}" FontSize="13"/>
                                                </Border>
                                                <Border Background="#224CAF50" CornerRadius="10" Padding="14,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplaySalesGeneratedText}" Foreground="{StaticResource StatGreenBrush}" FontSize="13"/>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding DataContext.AttendanceTodayTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                            <WrapPanel>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayClockInLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayClockOutLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                                </Border>
                                                <Border Background="#22D4AF37" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DisplayPendingSalaryText}" Foreground="{StaticResource GoldAccentBrush}" FontSize="12"/>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding DataContext.WorkScheduleTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GoldAccentBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,8"/>
                                            <Border Style="{StaticResource GlassCard}"
                                                    Padding="10,10"
                                                    Margin="0,0,0,8"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1">
                                                <ItemsControl ItemsSource="{Binding ScheduleDays}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1" Columns="7"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#18000000"
                                                                    CornerRadius="10"
                                                                    Padding="6,8"
                                                                    Margin="3,0">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DayShortName}"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource TextMutedBrush}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Margin="0,0,0,6"/>
                                                                    <Border CornerRadius="8"
                                                                            Padding="6,4"
                                                                            HorizontalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding BadgeVariant}" Value="Morning">
                                                                                        <Setter Property="Background" Value="#22D4AF37"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding BadgeVariant}" Value="Evening">
                                                                                        <Setter Property="Background" Value="#152196F3"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding BadgeVariant}" Value="FullDay">
                                                                                        <Setter Property="Background" Value="#1A34A853"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding BadgeText}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding BadgeVariant}" Value="Morning">
                                                                                            <Setter Property="Foreground" Value="{StaticResource GoldAccentBrush}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding BadgeVariant}" Value="Evening">
                                                                                            <Setter Property="Foreground" Value="{StaticResource StatBlueBrush}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding BadgeVariant}" Value="FullDay">
                                                                                            <Setter Property="Foreground" Value="#FF34A853"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DataContext.AttendanceStatusLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Border CornerRadius="10" Padding="12,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#22FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanClockOut}" Value="True">
                                                                    <Setter Property="Background" Value="#224CAF50"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold"
                                                               Text="{Binding DisplayAttendanceStatus}"/>
                                                </Border>
                                            </StackPanel>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Width="120"
                                                        Margin="0,0,10,0"
                                                        Content="{Binding DataContext.EditProfileLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SapphireButton}"/>
                                                <Button Grid.Column="1"
                                                        Width="120"
                                                        Margin="0,0,10,0"
                                                        Content="{Binding DataContext.ShiftHistoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.ShowShiftHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"/>
                                                <Button Grid.Column="2"
                                                        Width="120"
                                                        Content="{Binding DataContext.DeleteLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520">
                    <Grid MaxHeight="680">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding DialogTitle}"
                                   Style="{StaticResource HeadingMedium}"
                                   FontSize="22"/>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,18,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource EliteScrollViewer}">
                            <StackPanel>
                                <TextBlock Text="{Binding EmpEmployeeNameLabel}" Style="{StaticResource HeadingSmall}" Margin="0,4,0,8"/>
                                <TextBox Text="{Binding EmployeeName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>

                                <TextBlock Text="{Binding EmpRoleLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <ComboBox ItemsSource="{Binding RoleOptions}"
                                          SelectedItem="{Binding SelectedRoleOption}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                                <TextBlock Style="{StaticResource HeadingSmall}" Margin="0,18,0,8">
                                    <Run Text="{Binding EmpSignInIdLabel, Mode=OneWay}"/>
                                    <Run Text="{Binding EmpSignInIdHint, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                </TextBlock>
                                <TextBox Text="{Binding SignInId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         ToolTip="{Binding EmpSignInIdTooltip}"/>

                                <TextBlock Text="{Binding EmpPinCodeLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBlock Text="{Binding PinFieldHelpText}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>
                                <PasswordBox x:Name="PinPasswordBox"
                                             PasswordChanged="PinPasswordBox_OnPasswordChanged"
                                             Height="40"
                                             FontSize="14"
                                             Padding="10,6"
                                             Background="#33101828"
                                             BorderBrush="#55D4AF37"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource GoldAccentBrush}"/>

                                <TextBlock Text="{Binding EmpPhoneNumberLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>

                                <TextBlock Text="{Binding EmpMonthlySalaryLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBox Text="{Binding MonthlySalaryUsdText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         ToolTip="{Binding EmpMonthlySalaryTooltip}"/>

                                <TextBlock Text="{Binding EmpStaffMealDiscountLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBox Text="{Binding StaffMealDiscountPercentText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"
                                         ToolTip="{Binding EmpStaffMealDiscountTooltip}"/>

                                <TextBlock Text="{Binding EmpJoinDateLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBox Text="{Binding JoinDateText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EliteTextBox}"/>

                                <TextBlock Text="{Binding EmpEmploymentStatusLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <ComboBox ItemsSource="{Binding EmploymentStatusOptions}"
                                          SelectedItem="{Binding SelectedEmploymentStatusOption}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource EliteComboBox}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                                <TextBlock Text="{Binding EmpProfileImageLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SelectedImageFileName, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Style="{StaticResource EliteTextBox}"/>
                                    <Button Grid.Column="1"
                                            Width="96"
                                            Margin="10,0,0,0"
                                            Content="{Binding BrowseLabel}"
                                            Command="{Binding BrowseProfileImageCommand}"
                                            Style="{StaticResource SapphireButton}"/>
                                </Grid>

                                <TextBlock Text="{Binding EmpDialogNotesLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <TextBox Text="{Binding EmployeeNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Height="110"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Background="#FF0D0D1A"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         BorderThickness="1"
                                         Padding="10"/>

                                <TextBlock Text="{Binding EmpWeeklyScheduleLabel}" Style="{StaticResource HeadingSmall}" Margin="0,18,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="{Binding EmpMondayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedMondayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="{Binding EmpTuesdayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedTuesdayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="{Binding EmpWednesdayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedWednesdayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="{Binding EmpThursdayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedThursdayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="{Binding EmpFridayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedFridayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="{Binding EmpSaturdayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedSaturdayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding EmpSundayLabel}" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ShiftOptions}" SelectedItem="{Binding SelectedSundayShiftOption}" DisplayMemberPath="Label" Style="{StaticResource EliteComboBox}" ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="{Binding CancelLabel}"
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1"
                                    Content="{Binding EmpSaveEmployeeLabel}"
                                    Margin="8,0,0,0"
                                    Command="{Binding SaveEmployeeCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <components:ShiftHistoryOverlayView Grid.Column="1"
                                              Grid.Row="0"
                                              Grid.RowSpan="2"
                                              Panel.ZIndex="30"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
