<UserControl x:Class="EliteRestaurantPro.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <UserControl.Resources>
        <DataTemplate x:Key="ReportDirectoryItemTemplate">
            <Border Background="#18000000" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UniqueId}" Foreground="{StaticResource GoldAccentBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportDayTemplate">
            <Border Background="#18000000" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,2">
                        <TextBlock Text="{Binding DayText}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding TotalsText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="12,2,0,0"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#10000000" CornerRadius="7" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding EventTimeText}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding EventType}" Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/>
                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding EntityContext}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding RelatedInfo}" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="4" Text="{Binding MetricsText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}"
                               Style="{StaticResource HeadingLarge}" FontSize="26"/>
                    <TextBlock Text="{Binding PageSubtitle}"
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker SelectedDate="{Binding ReportStartDate}"
                                Width="132"
                                Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding ReportEndDate}"
                                Width="132"
                                Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ExportReportTypeOptions}"
                              SelectedItem="{Binding SelectedExportReportTypeOption}"
                              Width="140"
                              Style="{StaticResource EliteComboBox}"
                              Margin="0,0,8,0"/>
                    <Button Content="{Binding ExportExcelLabel}"
                            Width="115"
                            Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="{Binding BulkExcelLabel}"
                            Width="105"
                            Command="{Binding BulkExportExcelCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Width="110"
                        Content="{Binding RefreshLabel}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GoldPrimaryButton}"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="24,0,24,24" Padding="18">
                <TabControl Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="{Binding TabDailyLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#22000000" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DailyFeedTitle}"
                                               Foreground="{StaticResource GoldAccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DailySummary}"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DailyTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding TabOrdersLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#22000000" CornerRadius="12" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding OrdersByDayTitle}"
                                               Foreground="{StaticResource GoldAccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding OrdersSummary}"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding OrderTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding TabEmployeesLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#22000000" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding EmployeeDirectoryTitle}" Style="{StaticResource HeadingSmall}" Margin="6,4,6,8"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Employees}"
                                             SelectedItem="{Binding SelectedEmployee}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ItemTemplate="{StaticResource ReportDirectoryItemTemplate}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#22000000" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding EmployeeDetailsTitle}" Foreground="{StaticResource GoldAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding EmployeeSummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Border Grid.Row="2" Background="#18000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NotesSectionTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EmployeeNotes}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="3" Background="#18000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PayrollHistoryTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EmployeePayrollHistory}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding EmployeeTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding TabTablesLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#22000000" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TableDirectoryTitle}" Style="{StaticResource HeadingSmall}" Margin="6,4,6,8"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Tables}"
                                             SelectedItem="{Binding SelectedTable}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ItemTemplate="{StaticResource ReportDirectoryItemTemplate}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#22000000" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding TableDetailsTitle}" Foreground="{StaticResource GoldAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding TableSummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Border Grid.Row="2" Background="#18000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AssignedServerLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TableCurrentServer}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding TableTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding TabInventoryLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#22000000" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding InventoryDirectoryTitle}" Style="{StaticResource HeadingSmall}" Margin="6,4,6,8"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding InventoryItems}"
                                             SelectedItem="{Binding SelectedInventoryItem}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ItemTemplate="{StaticResource ReportDirectoryItemTemplate}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#22000000" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding InventoryDetailsTitle}" Foreground="{StaticResource GoldAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding InventorySummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Border Grid.Row="2" Background="#18000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding InventoryNotesTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <ScrollViewer MaxHeight="160"
                                                          Margin="0,4,0,0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          Style="{StaticResource EliteScrollViewer}">
                                                <TextBlock Text="{Binding InventoryNotes}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding InventoryTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding TabMenuLabel}">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#22000000" CornerRadius="12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding MenuDirectoryTitle}" Style="{StaticResource HeadingSmall}" Margin="6,4,6,8"/>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding MenuItems}"
                                             SelectedItem="{Binding SelectedMenuItem}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ItemTemplate="{StaticResource ReportDirectoryItemTemplate}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="#22000000" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding MenuItemDetailsTitle}" Foreground="{StaticResource GoldAccentBrush}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding MenuSummary}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Border Grid.Row="2" Background="#18000000" CornerRadius="10" Padding="10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding IngredientsTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MenuIngredientsSummary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MenuTimelineDays}" ItemTemplate="{StaticResource ReportDayTemplate}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
