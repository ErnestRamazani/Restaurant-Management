<UserControl x:Class="EliteRestaurantPro.Views.FirstSiteSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D0D1A" Offset="0"/>
                <GradientStop Color="#FF0A0A15" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="24,32">
                <TextBlock Text="First-time setup" Style="{StaticResource HeadingLarge}" FontSize="28"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Create your restaurant on the cloud before anyone signs in."
                           Style="{StaticResource BodyText}" FontSize="13" TextAlignment="Center"
                           Margin="0,8,0,24" TextWrapping="Wrap"/>

                <Border Style="{StaticResource GlassCard}" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="CLOUD API URL" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CloudApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="RESTAURANT NAME" Style="{StaticResource HeadingSmall}" Margin="0,18,0,6"/>
                        <TextBox Text="{Binding RestaurantName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="SLUG (optional)" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                        <TextBlock Text="Used in dev headers; auto-filled from name if empty."
                                   Style="{StaticResource BodyText}" FontSize="11" Opacity="0.75" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="CUSTOM DOMAIN (optional)" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                        <TextBlock Text="e.g. myrestaurant.com — add DNS in DigitalOcean after setup."
                                   Style="{StaticResource BodyText}" FontSize="11" Opacity="0.75" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CustomDomain, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="ADMIN SIGN-IN ID" Style="{StaticResource HeadingSmall}" Margin="0,18,0,6"/>
                        <TextBox Text="{Binding AdminSignInId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>

                        <TextBlock Text="ADMIN PIN" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="AdminPinBox" Style="{StaticResource ElitePasswordBox}"
                                     PasswordChanged="AdminPinBox_OnPasswordChanged"/>

                        <TextBlock Text="CONFIRM PIN" Style="{StaticResource HeadingSmall}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="ConfirmPinBox" Style="{StaticResource ElitePasswordBox}"
                                     PasswordChanged="ConfirmPinBox_OnPasswordChanged"/>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"
                                   FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.85"/>

                        <Border Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"
                                Background="#22F44336" CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFF44336" FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button Content="Test cloud connection" Margin="0,20,0,0"
                                Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource GhostButton}"/>
                        <Button Content="Create site &amp; sign in" Margin="0,10,0,0"
                                Command="{Binding CreateSiteCommand}"
                                Style="{StaticResource GoldPrimaryButton}"/>
                        <Button Content="Skip — site already exists" Margin="0,10,0,0"
                                Command="{Binding SkipCommand}"
                                Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
