<UserControl x:Class="EliteRestaurantPro.Views.MoneyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <UserControl.Resources>
        <Style x:Key="MoneyGlassCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2BFFFFFF"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style x:Key="MoneyInputTextBox" TargetType="TextBox" BasedOn="{StaticResource EliteTextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#1E0A0A15"/>
            <Setter Property="BorderBrush" Value="#55D4AF37"/>
            <Setter Property="CaretBrush" Value="{StaticResource GoldAccentBrush}"/>
        </Style>
        <Style x:Key="MoneyGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1C2238"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#553A415E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="MoneyGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF131A2B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#403A415E"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1C2642"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF233458"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MoneyGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#2F3A415E"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                    <Run Text="Money"/>
                    <Run Text=" Dashboard" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <TextBlock Text="Daily revenue and expenses in real-time."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MoneyGlassCard}">
                        <StackPanel>
                            <TextBlock Text="Today Revenue" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding TodayRevenueText}" Foreground="#2ECC71" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MoneyGlassCard}">
                        <StackPanel>
                            <TextBlock Text="Today Expenses" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding TodayExpensesText}" Foreground="#DC143C" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MoneyGlassCard}">
                        <StackPanel>
                            <TextBlock Text="Today Net" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding TodayNetProfitText}" Foreground="{Binding TodayNetProfitColor}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource MoneyGlassCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedPeriodLabel, StringFormat=Showing: {0}}"
                               Style="{StaticResource BodyText}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Week" Width="70" Margin="0,0,8,0" Command="{Binding SelectPeriodCommand}" CommandParameter="Week" Style="{StaticResource GhostButton}"/>
                        <Button Content="Month" Width="70" Margin="0,0,8,0" Command="{Binding SelectPeriodCommand}" CommandParameter="Month" Style="{StaticResource GhostButton}"/>
                        <Button Content="Year" Width="70" Margin="0,0,8,0" Command="{Binding SelectPeriodCommand}" CommandParameter="Year" Style="{StaticResource GhostButton}"/>
                        <Button Content="All" Width="70" Margin="0,0,8,0" Command="{Binding SelectPeriodCommand}" CommandParameter="All" Style="{StaticResource GhostButton}"/>
                        <Button Content="Refresh" Width="80" Command="{Binding RefreshLedgerCommand}" Style="{StaticResource SapphireButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.95*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MoneyGlassCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                        <StackPanel>
                            <TextBlock Text="Quick Entry" Style="{StaticResource HeadingMedium}" FontSize="15"/>
                            <TextBlock Text="Amount" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MoneyInputTextBox}"/>
                            <TextBlock Text="Currency" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding EntryCurrencies}"
                                      SelectedItem="{Binding SelectedCurrency}"
                                      Style="{StaticResource EliteComboBox}"/>
                            <TextBlock Text="Type" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding EntryTypes}" SelectedItem="{Binding SelectedType}" Style="{StaticResource EliteComboBox}"/>
                            <TextBlock Text="Category" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource EliteComboBox}"/>
                            <TextBlock Text="Date" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <DatePicker SelectedDate="{Binding EntryDate}"/>
                            <TextBlock Text="Justification" Style="{StaticResource HeadingSmall}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="70"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     IsEnabled="{Binding IsJustificationEnabled}"
                                     Style="{StaticResource MoneyInputTextBox}"/>
                            <Button Content="Add Entry" Margin="0,12,0,0" Height="36" Command="{Binding AddEntryCommand}" Style="{StaticResource SapphireButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MoneyGlassCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ledger (latest 200 entries)" Style="{StaticResource HeadingMedium}" FontSize="15"/>
                        <DataGrid Grid.Row="1"
                                  Margin="0,10,0,0"
                                  AutoGenerateColumns="False"
                                  ItemsSource="{Binding DailyLedger}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="#FF111528"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#2F3A415E"
                                  VerticalGridLinesBrush="#203A415E"
                                  HeadersVisibility="Column"
                                  RowHeight="34"
                                  ColumnHeaderStyle="{StaticResource MoneyGridHeaderStyle}"
                                  RowStyle="{StaticResource MoneyGridRowStyle}"
                                  CellStyle="{StaticResource MoneyGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:dd MMM HH:mm}}" Width="130"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                                <DataGridTextColumn Header="Justification" Binding="{Binding Justification}" Width="*"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="4">
                    <Border Style="{StaticResource MoneyGlassCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Period Revenue" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding TotalRevenueText}" Foreground="#2ECC71" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoneyGlassCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Period Expenses" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding TotalExpensesText}" Foreground="#DC143C" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoneyGlassCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Period Net" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="{Binding NetProfitText}" Foreground="{Binding NetProfitColor}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MoneyGlassCard}">
                        <StackPanel>
                            <TextBlock Text="Summary" Style="{StaticResource HeadingMedium}" FontSize="15"/>
                            <TextBlock Text="{Binding SalesSummaryText, StringFormat=Sales: {0}}" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding TipsSummaryText, StringFormat=Tips: {0}}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding PayrollSummaryText, StringFormat=Payroll: {0}}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Content="Generate Report (PDF)" Margin="0,12,0,0" Height="34" Command="{Binding GenerateReportCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="#70000000"
                    CornerRadius="10"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Loading money dashboard..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
