<UserControl x:Class="EliteRestaurantPro.Views.SalaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <UserControl.Resources>
        <Style x:Key="SalaryPayrollChip" TargetType="Border">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="SalaryConfirmButtonActive" TargetType="Button" BasedOn="{StaticResource GoldPrimaryButton}">
            <Setter Property="Content" Value="{Binding PayrollActionLabel}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinWidth" Value="160"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlreadyPaid}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="{StaticResource StatGreenBrush}"/>
                    <Setter Property="Foreground" Value="#FFF1FFF4"/>
                    <Setter Property="BorderBrush" Value="#FF2E7D32"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AlreadyPaid}" Value="False"/>
                        <Condition Binding="{Binding CanConfirmPayroll}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="#FF353540"/>
                    <Setter Property="Foreground" Value="#FF7A7A88"/>
                    <Setter Property="BorderBrush" Value="#55484858"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SalaryConfirmButtonTable" TargetType="Button" BasedOn="{StaticResource SalaryConfirmButtonActive}">
            <Setter Property="Content" Value="{Binding PayrollActionLabelShort}"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="SalaryGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1C2238"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#553A415E"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="SalaryGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FF131A2B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1C2642"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SalaryDataGridCellTextWrap" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource HeadingLarge}" FontSize="28">
                    <Run Text="{Binding PageTitlePrimary, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text="{Binding PageTitleAccent, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#22000000" CornerRadius="10" Padding="12,8" Margin="0,0,14,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <CheckBox Content="{Binding SimpleTableLayoutLabel, Mode=OneWay}"
                                  IsChecked="{Binding UseTableView, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="{Binding RefreshLabel, Mode=OneWay}"
                            Command="{Binding RefreshPayrollCommand}"
                            Style="{StaticResource GhostButton}"
                            Padding="14,10"
                            FontSize="14"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="24,0,24,12"
                    Padding="14,12"
                    CornerRadius="10"
                    Background="#33C62828"
                    BorderBrush="#88E57373"
                    BorderThickness="1"
                    Visibility="{Binding ShowPayrollOverdueWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding OverdueTitle, Mode=OneWay}"
                               Foreground="#FFEF9A9A"
                               FontWeight="SemiBold"
                               FontSize="15"/>
                    <TextBlock Text="{Binding PayrollOverdueWarningText}"
                               Foreground="#FFE0E0E0"
                               FontSize="14"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#FFB0B0B0">
                        <Run Text="{Binding DaysPastMonthEndLabel, Mode=OneWay}"/>
                        <Run Text="{Binding DaysPastPayDay, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="24,0,24,12" Padding="18,18">
                <StackPanel>
                    <TextBlock Text="{Binding AdvanceSectionTitle, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="19" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,14,0,0">
                        <TextBlock Text="{Binding EmployeeLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,10,10"/>
                        <ComboBox Width="260"
                                  Margin="0,0,20,10"
                                  ItemsSource="{Binding AdvanceEmployees}"
                                  SelectedItem="{Binding SelectedAdvanceEmployee}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding AmountUsdLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,10,10"/>
                        <TextBox Width="110"
                                 Margin="0,0,20,10"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Text="{Binding AdvanceAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>
                        <TextBlock Text="{Binding NoteLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,10,10"/>
                        <TextBox MinWidth="200"
                                 Width="280"
                                 Margin="0,0,16,10"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 Text="{Binding AdvanceNoteText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"/>
                        <Button Content="{Binding RecordAdvanceLabel, Mode=OneWay}"
                                Command="{Binding RecordSalaryAdvanceCommand}"
                                Style="{StaticResource GoldPrimaryButton}"
                                Margin="0,0,0,10"
                                Padding="16,10"
                                FontSize="14"
                                VerticalAlignment="Center"/>
                    </WrapPanel>
                    <Button Content="{Binding PayAllRemainingLabel, Mode=OneWay}"
                            Command="{Binding ConfirmAllPayrollCommand}"
                            Style="{StaticResource GoldPrimaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Padding="20,12"
                            FontSize="15"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="24,0,24,12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PayPeriodLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding YearLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,8,0"/>
                        <ComboBox Width="110"
                                  ItemsSource="{Binding YearChoices}"
                                  SelectedItem="{Binding SelectedPayrollYear}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                        <TextBlock Text="{Binding MonthLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="16,0,8,0"/>
                        <ComboBox Width="100"
                                  ItemsSource="{Binding MonthChoices}"
                                  SelectedItem="{Binding SelectedPayrollMonth}"
                                  Style="{StaticResource EliteComboBox}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                        <TextBlock Text="{Binding PayrollPeriodLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource GoldAccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="17"
                                   Margin="20,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="{Binding ShowLabel, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,12,0"/>
                        <RadioButton GroupName="SalaryEmployeeFilter"
                                     Content="{Binding FilterAllEmployeesLabel, Mode=OneWay}"
                                     IsChecked="{Binding FilterShowAllEmployees, Mode=TwoWay}"
                                     Margin="0,0,18,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="14"/>
                        <RadioButton GroupName="SalaryEmployeeFilter"
                                     Content="{Binding FilterPaidOnlyLabel, Mode=OneWay}"
                                     IsChecked="{Binding FilterShowPaidOnly, Mode=TwoWay}"
                                     Margin="0,0,18,0"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="14"/>
                        <RadioButton GroupName="SalaryEmployeeFilter"
                                     Content="{Binding FilterUnpaidOnlyLabel, Mode=OneWay}"
                                     IsChecked="{Binding FilterShowUnpaidOnly, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="24,0,24,24">
                <!-- Interactive cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource EliteScrollViewer}"
                              Visibility="{Binding UseInteractiveCards, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="0">
                                    <Expander Background="Transparent" BorderThickness="0">
                                        <Expander.Header>
                                            <Grid Margin="18,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="72"
                                                        Height="72"
                                                        Margin="0,0,16,0"
                                                        CornerRadius="36"
                                                        Background="#2A3048"
                                                        BorderBrush="#55D4AF37"
                                                        BorderThickness="1"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding HeaderProfileImage}">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HeaderHasProfilePhoto}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding EmployeeInitials}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="22"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource GoldAccentBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HeaderHasProfilePhoto}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding EmployeeName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                                               FontSize="26"
                                                               FontWeight="SemiBold"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Border Background="#22D4AF37" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding UniqueId}" Foreground="{StaticResource GoldAccentBrush}" FontSize="13"/>
                                                        </Border>
                                                        <Border CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#33D4AF37"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AlreadyPaid}" Value="True">
                                                                            <Setter Property="Background" Value="#224CAF50"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding AlreadyPaid}" Value="False"/>
                                                                                <Condition Binding="{Binding IsPartiallyPaid}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="#33E65100"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding PayStatusBadgeText, Mode=OneWay}" FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource GoldAccentBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AlreadyPaid}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatGreenBrush}"/>
                                                                            </DataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding AlreadyPaid}" Value="False"/>
                                                                                    <Condition Binding="{Binding IsPartiallyPaid}" Value="True"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Foreground" Value="#FFFFCC80"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Background="#152196F3" CornerRadius="8" Padding="10,5">
                                                            <TextBlock Text="{Binding HeaderMoneyChipText}"
                                                                       Foreground="{StaticResource StatBlueBrush}" FontSize="13"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="▼"
                                                           Foreground="{StaticResource GoldAccentBrush}"
                                                           FontFamily="Segoe UI"
                                                           FontSize="22"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </Expander.Header>

                                        <StackPanel Margin="18,0,18,22">
                                            <TextBlock Text="{Binding DataContext.ScheduleBaseSectionTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                            <WrapPanel>
                                                <Border Style="{StaticResource SalaryPayrollChip}">
                                                    <TextBlock Text="{Binding PayrollPrimaryRateChipText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                </Border>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SalaryPayrollChip}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UsesMonthlySalary}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ScheduledHoursChipText, Mode=OneWay}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                </Border>
                                                <Border Style="{StaticResource SalaryPayrollChip}">
                                                    <TextBlock Text="{Binding ScheduledWorkdaysChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                </Border>
                                                <Border Background="#22D4AF37" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                                    <TextBlock Text="{Binding BaseGrossChipText, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="14"/>
                                                </Border>
                                            </WrapPanel>

                                            <StackPanel Margin="0,16,0,12">
                                                <TextBlock Text="{Binding DataContext.AttendanceSectionTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                           Foreground="{StaticResource GoldAccentBrush}"
                                                           FontSize="19"
                                                           FontWeight="SemiBold"/>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Border Style="{StaticResource SalaryPayrollChip}">
                                                        <TextBlock Text="{Binding AbsencesChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                    </Border>
                                                    <Border Style="{StaticResource SalaryPayrollChip}">
                                                        <TextBlock Text="{Binding LatesChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                    </Border>
                                                    <Border Style="{StaticResource SalaryPayrollChip}">
                                                        <TextBlock Text="{Binding LateUnitsChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                    </Border>
                                                    <Border Style="{StaticResource SalaryPayrollChip}">
                                                        <TextBlock Text="{Binding TotalUnitsChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                    </Border>
                                                    <Border Background="#152196F3" CornerRadius="10" Padding="14,10" Margin="0,0,10,10">
                                                        <TextBlock Text="{Binding AfterAttendanceChipText, Mode=OneWay}" Foreground="{StaticResource StatBlueBrush}" FontSize="14"/>
                                                    </Border>
                                                </WrapPanel>
                                                <Button Content="{Binding DataContext.ShiftHistoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,10,0,0"
                                                        Padding="14,8"
                                                        FontSize="13"
                                                        Command="{Binding DataContext.ShowShiftHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding DataContext.SalesBonusSectionTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,16,0,12"/>
                                            <WrapPanel>
                                                <Border Style="{StaticResource SalaryPayrollChip}">
                                                    <TextBlock Text="{Binding SalesServedChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                </Border>
                                                <Border Style="{StaticResource SalaryPayrollChip}">
                                                    <TextBlock Text="{Binding SalesBonusChipText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                                </Border>
                                            </WrapPanel>

                                            <TextBlock Text="{Binding DataContext.AdvanceNetSectionTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,12"/>
                                            <Border Background="#1A0D0D12" CornerRadius="14" Padding="20,18" BorderBrush="#44FF6B6B" BorderThickness="1" Margin="0,0,0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding DataContext.AdvancesDeductedLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding AdvancesDisplayText, Mode=OneWay}"
                                                                   Foreground="#FFFF6B6B"
                                                                   FontSize="34"
                                                                   FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding NetPaySectionTitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding NetPayDisplayText, Mode=OneWay}"
                                                                   Foreground="#FF4ADE80"
                                                                   FontSize="34"
                                                                   FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#22000000" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap"
                                                               Visibility="{Binding HasPaidReceiptDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Run Text="{Binding PaidPrefix, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Run Text="{Binding PaidAmountDisplay, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}"/>
                                                        <Run Text="{Binding PaidOnSeparator, Mode=OneWay}" FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <Run Text="{Binding PaidDateDisplay, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" Foreground="#FFB8E6C1"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding ShowPlainStatusLine, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Setter Property="FontSize" Value="16"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AlreadyPaid}" Value="True">
                                                                        <Setter Property="FontSize" Value="19"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <Button HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.ConfirmSinglePayrollCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SalaryConfirmButtonActive}"
                                                    FontSize="15"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Table layout: DataGrid scrolls internally so column resize grips work; wrapping needs virtualization off -->
                <DataGrid ItemsSource="{Binding Rows}"
                          Visibility="{Binding UseTableView, Converter={StaticResource BoolToVisibilityConverter}}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="True"
                          CanUserResizeRows="True"
                          ColumnHeaderStyle="{StaticResource SalaryGridColumnHeader}"
                          RowStyle="{StaticResource SalaryGridRowStyle}"
                          Background="#FF131A2B"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="#2BFFFFFF"
                          RowBackground="#FF131A2B"
                          AlternatingRowBackground="#FF1A2235"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#223A415E"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MinHeight="200"
                          MinWidth="640"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          RowHeight="{x:Static sys:Double.NaN}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding DataContext.ColEmployeeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding EmployeeName}" Width="140" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SalaryDataGridCellTextWrap}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{Binding DataContext.ColIdLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding UniqueId}" Width="100" MinWidth="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SalaryDataGridCellTextWrap}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{Binding DataContext.ColMonthlyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding RateColumnText}" Width="100" MinWidth="88"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColHrsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding ScheduledHoursMonth, StringFormat=F1}" Width="56" MinWidth="48"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColDaysLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding ScheduledWorkdays}" Width="52" MinWidth="44"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColBaseLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableBaseGrossText}" Width="88" MinWidth="72"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColAbsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding AbsenceDays}" Width="44" MinWidth="40"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColLateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding LateDays}" Width="44" MinWidth="40"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColLateUnitsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding LatePenaltyAbsences}" Width="48" MinWidth="40"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColUnitsLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TotalDeductionUnits}" Width="52" MinWidth="44"/>
                        <DataGridTemplateColumn Header="{Binding DataContext.ShiftHistoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="108" MinWidth="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DataContext.ShiftHistoryLabel, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                            Margin="4,2"
                                            Padding="8,4"
                                            FontSize="12"
                                            Command="{Binding DataContext.ShowShiftHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource GhostButton}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{Binding DataContext.ColAfterAttLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableAfterAttText}" Width="92" MinWidth="78"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColSalesLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableSalesText}" Width="88" MinWidth="72"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColBonusLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableBonusText}" Width="78" MinWidth="64"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColAdvancesLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableAdvancesText}" Width="84" MinWidth="68"/>
                        <DataGridTextColumn Header="{Binding DataContext.ColOwedLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding TableNetPayText}" Width="82" MinWidth="68"/>
                        <DataGridTemplateColumn Header="{Binding DataContext.ColPayLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="108" MinWidth="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SalaryConfirmButtonTable}"
                                            Command="{Binding DataContext.ConfirmSinglePayrollCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{Binding DataContext.ColStatusLabel, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap"
                                                   Margin="4,6"
                                                   Visibility="{Binding HasPaidReceiptDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="{Binding PaidPrefix, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Run Text="{Binding PaidAmountDisplay, Mode=OneWay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource GoldAccentBrush}"/>
                                            <Run Text="{Binding PaidOnSeparator, Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                                            <Run Text="{Binding PaidDateDisplay, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#FFB8E6C1"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}"
                                                   TextWrapping="Wrap"
                                                   Margin="4,6"
                                                   Visibility="{Binding ShowPlainStatusLine, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlreadyPaid}" Value="True">
                                                            <Setter Property="FontSize" Value="15"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <components:ShiftHistoryOverlayView Grid.Row="0"
                                                Grid.RowSpan="5"
                                                Panel.ZIndex="40"
                                                VerticalAlignment="Stretch"
                                                HorizontalAlignment="Stretch"/>

            <Border Grid.Row="0" Grid.RowSpan="5"
                    Background="#CC0A0A12"
                    Panel.ZIndex="50"
                    Visibility="{Binding IsPayrollPaymentDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="400"
                        MaxWidth="520"
                        Background="#FF1A2238"
                        CornerRadius="14"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="{Binding PaymentDialogTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldAccentBrush}"/>
                        <TextBlock Text="{Binding PayrollPaymentDialogEmployee}"
                                   Margin="0,6,0,0"
                                   FontSize="17"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding PayrollPeriodLabel}"
                                   Margin="0,2,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding PayrollPaymentRemainingHint}"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding AmountToPayLabel, Mode=OneWay}"
                                   Margin="0,16,0,6"
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding PayrollPaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EliteTextBox}"
                                 FontSize="16"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Right">
                            <Button Content="{Binding CancelLabel, Mode=OneWay}"
                                    Command="{Binding CancelPayrollPaymentDialogCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="16,10"
                                    Margin="0,0,10,0"/>
                            <Button Content="{Binding RecordPaymentLabel, Mode=OneWay}"
                                    Command="{Binding SubmitPayrollPaymentDialogCommand}"
                                    Style="{StaticResource GoldPrimaryButton}"
                                    Padding="18,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
