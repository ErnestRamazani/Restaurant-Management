<UserControl x:Class="EliteRestaurantPro.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">

    <UserControl.Resources>
        <Style x:Key="DashboardClickableButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <!-- Flat template so activity rows never show default Button hover/pressed chrome -->
        <Style x:Key="ActivityCardButton" TargetType="Button" BasedOn="{StaticResource DashboardClickableButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardKpiTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="DashboardKpiHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Style="{StaticResource EliteScrollViewer}">
                <StackPanel Margin="20,18,20,28">

                    <!-- Header: welcome + DB status + live clock -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeadingLarge}" FontSize="28">
                                <Run Text="Welcome, " Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text="{Binding WelcomeName, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                            </TextBlock>
                            <TextBlock Text="Operations command center — today's performance, inventory risk, and team status."
                                       Style="{StaticResource BodyText}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DatabaseConnected}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource StatRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DatabaseStatusText, Mode=OneWay}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LiveClockText, Mode=OneWay}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,0,0,18"
                            Padding="14,12"
                            CornerRadius="10"
                            Background="#33C62828"
                            BorderBrush="#88E57373"
                            BorderThickness="1"
                            Visibility="{Binding ShowSalaryPayrollWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Salary payroll overdue"
                                       Foreground="#FFEF9A9A"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                            <TextBlock Text="{Binding SalaryPayrollWarningText, Mode=OneWay}"
                                       Foreground="#FFE8E8E8"
                                       FontSize="13"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#FFB0B0B0">
                                <Run Text="Days past month end: "/>
                                <Run Text="{Binding SalaryPayrollDaysPastDue, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- KPI: row 1 Money (ledger) · row 2 operations -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Money: USD revenue -->
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardClickableButton}" Command="{Binding NavigateToMoneyCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="{StaticResource StatBlueBrush}" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Today's revenue (USD)" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding TodayRevenueUsd, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="32" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding RevenueUsdVsYesterdayText, Mode=OneWay}" Foreground="{StaticResource StatBlueBrush}" Style="{StaticResource DashboardKpiHint}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Money · entries in USD only" Style="{StaticResource DashboardKpiHint}" Margin="0,4,0,0" Opacity="0.85"/>
                                        <Viewbox Height="42" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,12,0,0" MaxHeight="48">
                                            <Canvas Width="120" Height="28" ClipToBounds="True">
                                                <Polyline Points="{Binding SparklinePoints, Mode=OneWay}" Stroke="{StaticResource StatBlueBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Sparkline: 7-day USD revenue (Money)" Style="{StaticResource DashboardKpiHint}" Margin="0,6,0,0" FontSize="11" Opacity="0.75"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Money: FC revenue -->
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardClickableButton}" Command="{Binding NavigateToMoneyCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="#FFB8860B" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Today's revenue (FC)" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding TodayRevenueFc, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="32" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding RevenueFcVsYesterdayText, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" Style="{StaticResource DashboardKpiHint}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Money · entries in FC only (not converted from USD)" Style="{StaticResource DashboardKpiHint}" Margin="0,4,0,0" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Money: Expenses (USD total) -->
                        <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource DashboardClickableButton}" Command="{Binding NavigateToMoneyCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="#FFDC143C" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Today's expenses" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding TodayExpensesUsd, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="32" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding ExpensesVsYesterdayText, Mode=OneWay}" Foreground="#FFEF9A9A" Style="{StaticResource DashboardKpiHint}" Margin="0,8,0,0"/>
                                        <TextBlock Text="All expenses in USD (FC rows use stored USD equivalent)" Style="{StaticResource DashboardKpiHint}" Margin="0,4,0,0" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Tables occupied -->
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardClickableButton}" Command="{Binding OpenActiveOrdersCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="#FF00BCD4" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Tables occupied" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding OccupiedTablesText, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="30" Margin="0,10,0,0"/>
                                        <ProgressBar Value="{Binding OccupiedTablesPercent, Mode=OneWay}" Maximum="100" Height="12" Margin="0,14,0,0"
                                                     Foreground="{StaticResource StatBlueBrush}" Background="#22000000" BorderThickness="0"/>
                                        <TextBlock Text="{Binding ActiveOrdersCount, Mode=OneWay, StringFormat={}{0} active orders}" Style="{StaticResource DashboardKpiHint}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Active orders -->
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardClickableButton}" Command="{Binding OpenActiveOrdersCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="{StaticResource StatGreenBrush}" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Active orders" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding ActiveOrdersCount, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="32" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding InKitchenNowText, Mode=OneWay}" Foreground="{StaticResource StatGreenBrush}" Style="{StaticResource DashboardKpiHint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Completed today -->
                        <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource DashboardClickableButton}" Command="{Binding OpenTodaySalesCommand}">
                            <Border Style="{StaticResource GlassCard}" Padding="16,18" MinHeight="200" MinWidth="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="2" Background="#FF5C6BC0" Margin="-16,-18,-16,0"/>
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                        <TextBlock Text="Orders completed today" Style="{StaticResource DashboardKpiTitle}"/>
                                        <TextBlock Text="{Binding OrdersCompletedToday, Mode=OneWay}" Style="{StaticResource StatValue}" FontSize="32" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding CompletedVsYesterdayText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource DashboardKpiHint}" Margin="0,8,0,0"/>
                                        <TextBlock Text="From orders (not Money ledger)" Style="{StaticResource DashboardKpiHint}" Margin="0,4,0,0" Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>

                    <!-- Inventory list + Today's sales curve -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.35*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Inventory: name + quantity only, color by stock level -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="18,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Inventory" Command="{Binding NavigateToInventoryCommand}"
                                            Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"/>
                                    <StackPanel>
                                        <TextBlock Text="Inventory" Style="{StaticResource HeadingMedium}" FontSize="16"/>
                                    </StackPanel>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280" CanContentScroll="False" Style="{StaticResource EliteScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding InventoryDashboardRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,6" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#223A3A3A"/>
                                                            <Setter Property="BorderBrush" Value="#443A3A3A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding QuantityBand}" Value="Healthy">
                                                                    <Setter Property="Background" Value="#3322C55E"/>
                                                                    <Setter Property="BorderBrush" Value="#6622C55E"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QuantityBand}" Value="Low">
                                                                    <Setter Property="Background" Value="#33FF9800"/>
                                                                    <Setter Property="BorderBrush" Value="#88FF9800"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QuantityBand}" Value="Critical">
                                                                    <Setter Property="Background" Value="#33F44336"/>
                                                                    <Setter Property="BorderBrush" Value="#88F44336"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding QuantityBand}" Value="Out">
                                                                    <Setter Property="Background" Value="#44B71C1C"/>
                                                                    <Setter Property="BorderBrush" Value="#99E53935"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding QuantityLine}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Hourly + top dishes -->
                        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Today's sales rhythm" Style="{StaticResource HeadingMedium}" FontSize="16" Margin="0,0,0,4"/>
                                <TextBlock Text="Revenue by hour (completed &amp; open orders created today)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                                <Grid Height="150">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HourlyChartMaxLabel, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,6,0"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9"/>
                                    <TextBlock Grid.Column="0" Text="$0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,0"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="9"/>
                                    <Viewbox Grid.Column="1" Stretch="Uniform" Height="140" VerticalAlignment="Top">
                                        <Grid Width="640" Height="140">
                                            <Polygon Points="{Binding HourlyChartAreaPoints, Mode=OneWay}" StrokeThickness="0">
                                                <Polygon.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#882196F3" Offset="0"/>
                                                        <GradientStop Color="#112196F3" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Polygon.Fill>
                                            </Polygon>
                                            <Polyline Points="{Binding HourlyChartLinePoints, Mode=OneWay}" Stroke="{StaticResource StatBlueBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" StrokeEndLineCap="Round"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <UniformGrid Rows="1" Columns="7" Margin="40,4,0,0">
                                    <TextBlock Text="0h" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="4h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="8h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="12h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="16h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="20h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="23h" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </UniformGrid>

                                <TextBlock Text="Top dishes today" Style="{StaticResource HeadingSmall}" FontSize="13" Margin="0,18,0,10"/>
                                <ItemsControl ItemsSource="{Binding TopSellingDishes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <Border Height="6" CornerRadius="3" Background="#22000000" Margin="0,4,0,0">
                                                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource GoldAccentBrush}"
                                                                Height="6" MinWidth="4" Width="{Binding BarWidthPx, Mode=OneWay}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Top"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Staff presence -->
                    <Border Style="{StaticResource GlassCard}" Padding="18,16" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Team on roster" Style="{StaticResource HeadingMedium}" FontSize="16" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ClockedInStaff, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="Attendance" Command="{Binding OpenClockedInStaffCommand}" Style="{StaticResource GhostButton}" Padding="12,6" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding NotYetInText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,-6,0,12"/>
                            <ItemsControl ItemsSource="{Binding StaffPresence}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="18" Padding="14,8" Margin="0,0,10,10" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#224CAF50"/>
                                                        <Setter Property="BorderBrush" Value="#554CAF50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsClockedIn}" Value="False">
                                                                <Setter Property="Background" Value="#22333340"/>
                                                                <Setter Property="BorderBrush" Value="#44333350"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource StatGreenBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsClockedIn}" Value="False">
                                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Bottom"/>
                                                            <TextBlock Text="{Binding OnDutyLabel, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Weekly chart + Recent activity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource DashboardClickableButton}" Command="{Binding OpenWeeklyRevenueCommand}" VerticalAlignment="Stretch">
                            <Border Style="{StaticResource GlassCard}" Padding="22,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="Weekly revenue" Style="{StaticResource HeadingMedium}" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource StatBlueBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="This week (Mon–Fri)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Row="0" Grid.Column="0" Height="168" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding WeeklyChartMaxLabel, Mode=OneWay}" VerticalAlignment="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                            <TextBlock Text="$0" VerticalAlignment="Bottom" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        </Grid>
                                        <Viewbox Grid.Row="0" Grid.Column="1" Stretch="Fill" Height="168" VerticalAlignment="Top">
                                            <Grid Width="580" Height="168">
                                                <Line X1="0" Y1="0" X2="580" Y2="0" Stroke="#22FFFFFF" StrokeThickness="1"/>
                                                <Line X1="0" Y1="42" X2="580" Y2="42" Stroke="#15FFFFFF" StrokeThickness="1" StrokeDashArray="4,4"/>
                                                <Line X1="0" Y1="84" X2="580" Y2="84" Stroke="#15FFFFFF" StrokeThickness="1" StrokeDashArray="4,4"/>
                                                <Line X1="0" Y1="126" X2="580" Y2="126" Stroke="#15FFFFFF" StrokeThickness="1" StrokeDashArray="4,4"/>
                                                <Line X1="0" Y1="168" X2="580" Y2="168" Stroke="#22FFFFFF" StrokeThickness="1"/>
                                                <Polygon Points="{Binding ChartAreaPoints, Mode=OneWay}" StrokeThickness="0">
                                                    <Polygon.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#882196F3" Offset="0"/>
                                                            <GradientStop Color="#112196F3" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polygon.Fill>
                                                </Polygon>
                                                <Polyline Points="{Binding ChartLinePoints, Mode=OneWay}" Stroke="{StaticResource StatBlueBrush}" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Viewbox>
                                        <UniformGrid Grid.Row="1" Grid.Column="1" Rows="1" Columns="5" Margin="0,8,0,0">
                                            <TextBlock Text="Mon" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="Tue" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="Wed" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="Thu" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="Fri" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </UniformGrid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="18,18">
                            <StackPanel>
                                <TextBlock Text="Recent activity" Style="{StaticResource HeadingMedium}" FontSize="16" Margin="0,0,0,14"/>
                                <TextBlock Text="Last 25 events · tap a card to open Orders, Attendance, or Inventory." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,-8,0,12" TextWrapping="Wrap"/>
                                <ScrollViewer MaxHeight="520"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Style="{StaticResource EliteScrollViewer}">
                                    <ItemsControl ItemsSource="{Binding RecentActivities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ActivityCardButton}"
                                                        Command="{Binding DataContext.OpenActivityItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Border Margin="0,0,0,10"
                                                            Padding="14,12"
                                                            CornerRadius="12"
                                                            HorizontalAlignment="Stretch"
                                                            Background="#2A2D34"
                                                            BorderBrush="#35FFFFFF"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        CornerRadius="10"
                                                                        Padding="10,4"
                                                                        Background="#1E000000"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding KindLabel}"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#B8B8C0"/>
                                                                </Border>
                                                                <Border Grid.Column="1"
                                                                        Height="1"
                                                                        Background="{StaticResource GoldAccentBrush}"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0,0,0"
                                                                        Opacity="0.75"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding DetailBlock}"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="13"
                                                                       Margin="0,8,0,0"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="18"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
