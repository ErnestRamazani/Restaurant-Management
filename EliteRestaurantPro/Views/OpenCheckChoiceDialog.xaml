<Window x:Class="EliteRestaurantPro.Views.OpenCheckChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle, Mode=OneWay}"
        Width="520"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="14"
            Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#99000000" Opacity="0.8"/>
        </Border.Effect>
        <Border Style="{StaticResource GlassCard}" Margin="20" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="Transparent"
                        Padding="0,0,0,4"
                        Cursor="Hand"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock x:Name="TitleHeading"
                               Style="{StaticResource HeadingMedium}"
                               Text="{Binding DialogHeading, Mode=OneWay}"/>
                </Border>

                <TextBlock x:Name="SummaryText"
                           Grid.Row="1"
                           Style="{StaticResource BodyText}"
                           Text="{Binding SummaryText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <Border Grid.Row="2"
                        CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,16"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        Background="#22000000">
                    <StackPanel>
                        <TextBlock x:Name="PromptText"
                                   Style="{StaticResource BodyText}"
                                   Text="{Binding PromptText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtotalText"
                                   Style="{StaticResource BodyText}"
                                   Text="{Binding SubtotalText, Mode=OneWay}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource GoldAccentBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3"
                           Style="{StaticResource HeadingSmall}"
                           Text="{Binding ChooseHowLabel, Mode=OneWay}"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="4" Orientation="Vertical">
                    <Button x:Name="AppendButton"
                            Content="{Binding AppendButtonLabel, Mode=OneWay}"
                            Style="{StaticResource GoldPrimaryButton}"
                            MinWidth="280"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            IsDefault="True"
                            Click="Append_Click"/>
                    <Button Content="{Binding NewTicketButtonLabel, Mode=OneWay}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="280"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="NewTicket_Click"/>
                    <Button Content="{Binding BackButtonLabel, Mode=OneWay}"
                            Style="{StaticResource GhostButton}"
                            MinWidth="280"
                            HorizontalAlignment="Stretch"
                            IsCancel="True"
                            Click="Back_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
