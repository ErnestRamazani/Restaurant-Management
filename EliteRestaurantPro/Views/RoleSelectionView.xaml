<UserControl x:Class="EliteRestaurantPro.Views.RoleSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LandingRoleButton" TargetType="Button">
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    CornerRadius="20"
                                    BorderBrush="#2FFFFFFF"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2D202A44" Offset="0"/>
                                        <GradientStop Color="#1A0F1628" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <ContentPresenter Margin="20,0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88D4AF37"/>
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A2E3C5D" Offset="0"/>
                                            <GradientStop Color="#20202B40" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF070B1A" Offset="0"/>
                <GradientStop Color="#FF090F23" Offset="0.55"/>
                <GradientStop Color="#FF0A122C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Image Source="{Binding RoleHeaderBackgroundImage}" Stretch="UniformToFill" Opacity="0.22">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RoleHeaderHasBackgroundImage}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <Ellipse Width="900" Height="900" Opacity="0.11"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#66D4AF37" Offset="0"/>
                    <GradientStop Color="#10D4AF37" Offset="0.45"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="0"
                                  Color="#7FD4AF37" Opacity="0.4"/>
            </Ellipse.Effect>
        </Ellipse>

        <Border Width="1120" MaxWidth="1120" MinHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="54,52" CornerRadius="34" BorderThickness="1"
                BorderBrush="#22FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2E111A31" Offset="0"/>
                    <GradientStop Color="#1F0A1124" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270"
                                  Color="#CC000000" Opacity="0.38"/>
            </Border.Effect>

            <Grid x:Name="LandingRoot" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform Y="14"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RoleHeaderRestaurantName}"
                               Style="{StaticResource HeadingLarge}"
                               FontSize="56"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,0"/>

                    <UniformGrid Rows="2" Columns="2" Margin="0,34,0,0">
                        <Button Command="{Binding SelectAdminCommand}" Style="{StaticResource LandingRoleButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE734;" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{StaticResource GoldAccentBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RoleAdminTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RoleAdminDesc}" FontSize="12" Foreground="#A8BECEE7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="&#xE72A;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#82FFFFFF" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SelectCashierCommand}" Style="{StaticResource LandingRoleButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8C7;" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{StaticResource StatBlueBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RoleCashierTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RoleCashierDesc}" FontSize="12" Foreground="#A8BECEE7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="&#xE72A;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#82FFFFFF" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SelectServerCommand}" Style="{StaticResource LandingRoleButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B5;" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{StaticResource StatGreenBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RoleServerTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RoleServerDesc}" FontSize="12" Foreground="#A8BECEE7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="&#xE72A;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#82FFFFFF" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>

                        <Button Command="{Binding SelectKitchenBarCommand}" Style="{StaticResource LandingRoleButton}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE976;" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{StaticResource StatOrangeBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RoleKitchenBarTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RoleKitchenBarDesc}" FontSize="12" Foreground="#A8BECEE7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="&#xE72A;" Grid.Column="2" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#82FFFFFF" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Button>
                    </UniformGrid>

                </StackPanel>

                <Border Grid.Column="1"
                        Margin="18,-14,-18,-14"
                        Padding="28,28,28,24"
                        CornerRadius="26"
                        BorderBrush="#2CFFFFFF"
                        BorderThickness="1,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#34102A4F" Offset="0"/>
                            <GradientStop Color="#2A0D2348" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.Width>340</Grid.Width>
                            <Grid.Height>340</Grid.Height>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Ellipse Width="316" Height="316" Opacity="0.38">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#50D4AF37" Offset="0"/>
                                        <GradientStop Color="#00D4AF37" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse Width="228" Height="228" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Stroke="#70FFFFFF" StrokeThickness="1.3">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoleHeaderHasLogo}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding RoleHeaderLogoImage}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Ellipse Width="228" Height="228" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoleHeaderHasLogo}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFD4AF37" Offset="0"/>
                                        <GradientStop Color="#FFA7872A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="0"
                                                      Color="#FFD4AF37" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="92"
                                       Foreground="#FF111829"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RoleHeaderHasLogo}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding RoleHeaderAddressText}"
                                       Style="{StaticResource BodyText}" FontSize="12.5"
                                       Foreground="#C7D5ECFF"/>
                            <TextBlock Text="{Binding RoleHeaderWebsiteText}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource BodyText}" FontSize="12.5"
                                       Foreground="#C7D5ECFF"/>
                            <TextBlock Text="{Binding RoleHeaderSocialText}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource BodyText}" FontSize="12.5"
                                       Foreground="#C7D5ECFF"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="LandingRoot"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.65"/>
                        <DoubleAnimation Storyboard.TargetName="LandingRoot"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="14" To="0" Duration="0:0:0.65">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="1" To="1.05"
                                         Duration="0:0:2.4"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>
                        <DoubleAnimation Storyboard.TargetName="LogoScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="1" To="1.05"
                                         Duration="0:0:2.4"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
