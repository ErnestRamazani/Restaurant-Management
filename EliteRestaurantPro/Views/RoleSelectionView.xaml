<UserControl x:Class="EliteRestaurantPro.Views.RoleSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0D0D1A" Offset="0"/>
                <GradientStop Color="#FF0A0A15" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Ambient background glow -->
        <Ellipse Width="600" Height="600" Opacity="0.035"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFD4AF37" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Width="52" Height="52" CornerRadius="14"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD4AF37" Offset="0"/>
                            <GradientStop Color="#FFAA8B22" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                          Color="#FFD4AF37" Opacity="0.4"/>
                    </Border.Effect>
                    <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="#FF0D0D1A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource HeadingLarge}"
                           FontSize="32">
                    <Run Text="Elite" Foreground="{StaticResource GoldAccentBrush}"/>
                    <Run Text="Restaurant" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text="Pro" Foreground="{StaticResource TextSecondaryBrush}"/>
                </TextBlock>

                <TextBlock Text="Select your role to continue"
                           HorizontalAlignment="Center" Margin="0,8,0,0"
                           Style="{StaticResource BodyText}" FontSize="14"/>
            </StackPanel>

            <!-- Role Cards Row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,32,0,0">

                <!-- ADMIN — fully active -->
                <Button Command="{Binding SelectAdminCommand}"
                        Style="{StaticResource RoleCardButton}"
                        Margin="12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#55D4AF37" Offset="0"/>
                                    <GradientStop Color="#22D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Admin" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldAccentBrush}"/>
                        <TextBlock Text="Full Access" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- CASHIER -->
                <Button Command="{Binding SelectCashierCommand}"
                        Style="{StaticResource RoleCardButton}"
                        Margin="12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#552196F3" Offset="0"/>
                                    <GradientStop Color="#222196F3" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{StaticResource StatBlueBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Cashier" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatBlueBrush}"/>
                        <TextBlock Text="Validate &amp; kitchen" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- SERVER -->
                <Button Command="{Binding SelectServerCommand}"
                        Style="{StaticResource RoleCardButton}"
                        Margin="12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#554CAF50" Offset="0"/>
                                    <GradientStop Color="#224CAF50" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{StaticResource StatGreenBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Server" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatGreenBrush}"/>
                        <TextBlock Text="Send to cashier" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <!-- KITCHEN / BAR -->
                <Button Command="{Binding SelectKitchenBarCommand}"
                        Style="{StaticResource RoleCardButton}"
                        Margin="12,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="14"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#55FF9800" Offset="0"/>
                                    <GradientStop Color="#22FF9800" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE976;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{StaticResource StatOrangeBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Kitchen / Bar" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatOrangeBrush}"/>
                        <TextBlock Text="Prep queue &amp; pickup" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Footer hint -->
            <TextBlock Text="All tablets use Sign-in ID + PIN from Admin → Employees (Chef, Barman, Sous Chef for Kitchen / Bar)."
                       HorizontalAlignment="Center" Margin="0,36,0,0"
                       Style="{StaticResource BodyText}" FontSize="12" Opacity="0.5"
                       TextAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
