<UserControl x:Class="EliteRestaurantPro.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="ReservationsDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#33FFFFFF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#22FFFFFF"/>
            <Setter Property="RowBackground" Value="#22000000"/>
            <Setter Property="AlternatingRowBackground" Value="#30000000"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style x:Key="ReservationsDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="#FF081326"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ReservationsDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReservationUrgency}" Value="Past">
                    <Setter Property="Background" Value="#40C0392B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReservationUrgency}" Value="Today">
                    <Setter Property="Background" Value="#40D68910"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReservationUrgency}" Value="Soon">
                    <Setter Property="Background" Value="#303498DB"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3376A8FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF3A5D9A"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReservationsDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFF4F7FF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF3A5D9A"/>
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="Reservations"/>
                        <Run Text=" Desk" Foreground="{StaticResource GoldAccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Create bookings, confirm, track countdown, mark arrival, then send guests into Take Order."
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Width="170"
                        Margin="10,0,0,0"
                        Content="New Reservation"
                        Command="{Binding OpenReservationDialogCommand}"
                        Style="{StaticResource GoldPrimaryButton}"
                        Visibility="{Binding CanManageReservations, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     Style="{StaticResource EliteTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by guest, phone, table, or reservation ID"/>
                            <ComboBox Grid.Column="1"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      Style="{StaticResource EliteComboBox}"/>
                            <ComboBox Grid.Column="2"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding ChannelFilters}"
                                      SelectedItem="{Binding SelectedChannelFilter, Mode=TwoWay}"
                                      Style="{StaticResource EliteComboBox}"/>
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Text="Urgency key: Red = past due, Orange = today, Blue = next 48h. Confirm starts countdown bar."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Margin="0,56,0,0"
                        Padding="8,4"
                        CornerRadius="8"
                        Background="#22000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Loading reservations..."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"/>
                </Border>

                <TextBlock Grid.Row="0"
                           Margin="0,86,0,0"
                           Foreground="{StaticResource StatRedBrush}"
                           FontSize="11"
                           Text="{Binding LoadStatus}"/>

                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                    <ItemsControl ItemsSource="{Binding Reservations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="0">
                                    <Expander Background="Transparent" BorderThickness="0" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <Grid Margin="14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ReservationDisplayName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Border Background="#22D4AF37" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding UniqueId}" Foreground="{StaticResource GoldAccentBrush}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="#152196F3" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource StatBlueBrush}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding ReservedFor, StringFormat={}{0:dd MMM HH:mm}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                        </Border>
                                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="10,4">
                                                            <TextBlock Text="{Binding DaysUntilReservation, StringFormat=Days left {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="▼" Foreground="{StaticResource GoldAccentBrush}" FontSize="20" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Expander.Header>

                                        <Grid Margin="14,0,14,14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <WrapPanel>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="Guest: "/><Run Text="{Binding GuestName}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="Phone: "/><Run Text="{Binding GuestPhone}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="Party: "/><Run Text="{Binding PartySize}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="Table: "/><Run Text="{Binding TableDisplayName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,0,8,8">
                                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                        <Run Text="Deposit: $ "/><Run Text="{Binding DepositAmountUsd, StringFormat={}{0:0.##}}"/>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>

                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Countdown"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1" Margin="8,0,0,0" Width="240" HorizontalAlignment="Left">
                                                    <Border Height="10" CornerRadius="5" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#22000000"/>
                                                    <ProgressBar Height="10"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ReservationHealthPercent, Mode=OneWay}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar">
                                                                <Setter Property="Foreground">
                                                                    <Setter.Value>
                                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                            <GradientStop Color="#2EC5FF" Offset="0"/>
                                                                            <GradientStop Color="#5A7CFF" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ReservationHealthState}" Value="Warning">
                                                                        <Setter Property="Foreground">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                                    <GradientStop Color="#FFD166" Offset="0"/>
                                                                                    <GradientStop Color="#FF8C42" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ReservationHealthState}" Value="Critical">
                                                                        <Setter Property="Foreground">
                                                                            <Setter.Value>
                                                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                                    <GradientStop Color="#FF6B6B" Offset="0"/>
                                                                                    <GradientStop Color="#C9184A" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </Grid>
                                            </Grid>

                                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                                <Button Width="96" Margin="0,0,8,0"
                                                        Content="Edit"
                                                        Command="{Binding DataContext.EditReservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SapphireButton}"
                                                        Visibility="{Binding CanShowEditAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Width="96" Margin="0,0,8,0"
                                                        Content="Confirm"
                                                        Command="{Binding DataContext.ConfirmReservationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GoldPrimaryButton}"
                                                        Visibility="{Binding CanShowConfirmAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Width="96" Margin="0,0,8,0"
                                                        Content="Arrived"
                                                        Command="{Binding DataContext.MarkArrivedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SapphireButton}"
                                                        Visibility="{Binding CanShowArrivedAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Width="96" Margin="0,0,8,0"
                                                        Content="No-show"
                                                        Command="{Binding DataContext.MarkNoShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Visibility="{Binding CanShowNoShowAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <Button Width="96"
                                                        Content="Cancel"
                                                        Command="{Binding DataContext.MarkCancelledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButton}"
                                                        Visibility="{Binding CanShowCancelAction, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Grid Grid.RowSpan="2" Background="#88070A13"
                  Visibility="{Binding IsReservationDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="620"
                                  Style="{StaticResource EliteScrollViewer}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReservationDialogTitle}" Style="{StaticResource HeadingMedium}" FontSize="22"/>
                            <TextBlock Text="Reservation name" Style="{StaticResource HeadingSmall}" Margin="0,18,0,6"/>
                            <TextBox Text="{Binding ReservationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}" ToolTip="Short internal name (e.g. Birthday - Messi)"/>
                            <TextBlock Text="Guest name" Style="{StaticResource HeadingSmall}" Margin="0,18,0,6"/>
                            <TextBox Text="{Binding ReservationGuestName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>

                            <TextBlock Text="Guest phone" Style="{StaticResource HeadingSmall}" Margin="0,12,0,6"/>
                            <TextBox Text="{Binding ReservationGuestPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Party size" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ReservationPartySizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="Date" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding ReservationDate, Mode=TwoWay}" Height="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Time (HH:mm)" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ReservationTimeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Channel" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding ReservationChannels}" SelectedItem="{Binding ReservationChannel, Mode=TwoWay}" Style="{StaticResource EliteComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Assigned table" Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Tables}"
                                              SelectedValue="{Binding ReservationTableId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Style="{StaticResource EliteComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text="  (T"/>
                                                    <Run Text="{Binding TableNumber}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Status}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Deposit paid" IsChecked="{Binding ReservationDepositPaid, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding ReservationDepositAmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="USD"/>
                            </Grid>

                            <TextBlock Text="Notes (kept exactly as user typed)" Style="{StaticResource HeadingSmall}" Margin="0,12,0,6"/>
                            <TextBox Text="{Binding ReservationNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EliteTextBox}" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelReservationDialogCommand}" Style="{StaticResource GhostButton}"/>
                                <Button Grid.Column="1" Content="Save reservation" Margin="8,0,0,0" Command="{Binding SaveReservationCommand}" Style="{StaticResource GoldPrimaryButton}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
