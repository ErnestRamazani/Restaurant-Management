<UserControl x:Class="EliteRestaurantPro.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <UserControl.Resources>
        <Style x:Key="ValidateAttendanceButtonStyle" TargetType="Button" BasedOn="{StaticResource SapphireButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Background" Value="#FF3A3A42"/>
                    <Setter Property="Foreground" Value="#FF888899"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShiftFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource SapphireButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF7FAFF"/>
        </Style>
        <Style x:Key="ShiftFilterButtonAllStyle" TargetType="Button" BasedOn="{StaticResource ShiftFilterButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftFilterAllSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GoldAccentBrush}"/>
                    <Setter Property="Foreground" Value="#FF0D0D1A"/>
                    <Setter Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShiftFilterButtonMorningStyle" TargetType="Button" BasedOn="{StaticResource ShiftFilterButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftFilterMorningSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GoldAccentBrush}"/>
                    <Setter Property="Foreground" Value="#FF0D0D1A"/>
                    <Setter Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShiftFilterButtonNightStyle" TargetType="Button" BasedOn="{StaticResource ShiftFilterButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShiftFilterNightSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GoldAccentBrush}"/>
                    <Setter Property="Foreground" Value="#FF0D0D1A"/>
                    <Setter Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="24,20,24,12"
                    Padding="20,18,20,16"
                    Style="{StaticResource GlassCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="{Binding PageTitle, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text="{Binding PageTitleAccent, Mode=OneWay}" Foreground="{StaticResource GoldAccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AttendanceShiftSummaryText}"
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding ShowLabel}"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="13"/>
                    <Button Content="{Binding FilterAllLabel}"
                            Command="{Binding SetShiftFilterAllCommand}"
                            Style="{StaticResource ShiftFilterButtonAllStyle}"/>
                    <Button Content="{Binding FilterMorningLabel}"
                            Command="{Binding SetShiftFilterMorningCommand}"
                            Style="{StaticResource ShiftFilterButtonMorningStyle}"/>
                    <Button Content="{Binding FilterNightLabel}"
                            Command="{Binding SetShiftFilterNightCommand}"
                            Style="{StaticResource ShiftFilterButtonNightStyle}"/>
                    <Button Content="{Binding FilterFullDayLabel}"
                            Margin="0"
                            Command="{Binding SetShiftFilterFullDayCommand}"
                            Style="{StaticResource ShiftFilterButtonStyle}"/>
                </StackPanel>
                <TextBox Grid.Row="2"
                         Margin="0,16,0,0"
                         Style="{StaticResource EliteTextBox}"
                         Height="42"
                         MinHeight="42"
                         FontSize="13"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SearchTooltip}"/>
            </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="24,4,24,24" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                <ItemsControl ItemsSource="{Binding AttendanceDayGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,12"
                                      IsExpanded="{Binding IsExpanded}">
                                <Expander.Header>
                                    <DockPanel LastChildFill="True" Margin="2,2,2,2">
                                        <Button DockPanel.Dock="Right"
                                                Content="{Binding DataContext.ValidateLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="12,0,0,0"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.ValidateAttendanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanValidateAttendance}"
                                                Style="{StaticResource ValidateAttendanceButtonStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DayText}"
                                                       Style="{StaticResource HeadingSmall}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource GoldAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EmployeesCountText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>

                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,12" Padding="18">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EmployeeName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17"/>
                                                        <TextBlock Text="{Binding DisplayLateJustificationText}"
                                                                   Foreground="{StaticResource StatRedBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding ShowLateJustification, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding DataContext.AbsenceEditorLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Style="{StaticResource HeadingSmall}"
                                                                   FontSize="11"
                                                                   Margin="0,12,0,6"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Visibility="{Binding ShowAbsenceJustificationEditor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding DataContext.AbsenceReadOnlyLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Style="{StaticResource HeadingSmall}"
                                                                   FontSize="11"
                                                                   Margin="0,12,0,6"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Visibility="{Binding ShowAbsenceJustificationReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBox Text="{Binding AbsenceJustification, UpdateSourceTrigger=PropertyChanged}"
                                                                 MinHeight="72"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                                 Background="#FF0D0D1A"
                                                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                 BorderThickness="1"
                                                                 Padding="10"
                                                                 IsReadOnly="False"
                                                                 Visibility="{Binding ShowAbsenceJustificationEditor, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding AbsenceJustification}"
                                                                   MinHeight="72"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="13"
                                                                   Padding="10"
                                                                   Background="#22000000"
                                                                   Visibility="{Binding ShowAbsenceJustificationReadOnly, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding EmployeeUniqueId}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding DisplayShiftLine}"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding DisplayClockLine}"
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding DisplayStatusLine}"
                                                                   Foreground="{StaticResource StatBlueBrush}"
                                                                   FontSize="12" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding DisplayPendingSalaryText}"
                                                                   Foreground="{StaticResource GoldAccentBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,2,0,0" VerticalAlignment="Top">
                                                        <Button Width="100"
                                                                Margin="0,0,6,0"
                                                                Content="{Binding DataContext.ClockInLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.ClockInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanClockIn}"
                                                                Style="{StaticResource GoldPrimaryButton}"/>
                                                        <Button Width="100"
                                                                Margin="0,0,6,0"
                                                                Content="{Binding DataContext.ClockOutLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.ClockOutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanClockOut}"
                                                                Style="{StaticResource SapphireButton}"/>
                                                        <Button Width="100"
                                                                Content="{Binding DataContext.AbsenceLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip="Mark as absent and enter justification"
                                                                Command="{Binding DataContext.MarkAbsenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanMarkAbsence}"
                                                                Style="{StaticResource GhostButton}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsMarkAbsenceDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <StackPanel>
                        <TextBlock Text="{Binding MarkAbsenceDialogTitle}" Style="{StaticResource HeadingMedium}" FontSize="22"/>
                        <TextBlock Text="{Binding MarkAbsenceBody}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding JustificationRequiredLabel}" Style="{StaticResource HeadingSmall}" Margin="0,20,0,8"/>
                        <TextBox Text="{Binding MarkAbsenceJustification, UpdateSourceTrigger=PropertyChanged}"
                                 Height="110"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="#FF0D0D1A"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Padding="10"/>
                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding CancelLabel}" Margin="0,0,8,0" Command="{Binding CancelMarkAbsenceCommand}" Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1" Content="{Binding SaveAbsenceLabel}" Margin="8,0,0,0" Command="{Binding SaveMarkAbsenceCommand}" Style="{StaticResource DangerButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsJustificationDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource HeadingMedium}" FontSize="22"/>
                        <TextBlock Text="{Binding LateDialogBody}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding JustificationRequiredLabel}" Style="{StaticResource HeadingSmall}" Margin="0,20,0,8"/>
                        <TextBox Text="{Binding LateJustification, UpdateSourceTrigger=PropertyChanged}"
                                 Height="110"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="#FF0D0D1A"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Padding="10"/>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding CancelLabel}" Margin="0,0,8,0" Command="{Binding CancelLateClockInCommand}" Style="{StaticResource GhostButton}"/>
                            <Button Grid.Column="1" Content="{Binding SaveLateClockInLabel}" Margin="8,0,0,0" Command="{Binding SaveLateClockInCommand}" Style="{StaticResource DangerButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
