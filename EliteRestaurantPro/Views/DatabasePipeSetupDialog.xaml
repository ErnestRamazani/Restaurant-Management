<Window x:Class="EliteRestaurantPro.Views.DatabasePipeSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Setup"
        Height="320"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Enter PostgreSQL as pipe-separated fields: host|port|database|username|password&#x0a;&#x0a;Example: localhost|5432|elite_restaurant|postgres|your_password&#x0a;&#x0a;Or cancel and set ELITE_DB_PROVIDER=PostgreSql and ELITE_POSTGRES_CONNECTION."/>
        <TextBox x:Name="PipeInputBox" Grid.Row="1" AcceptsReturn="False" VerticalScrollBarVisibility="Disabled"
                 Text="localhost|5432|elite_restaurant|postgres|postgres" FontFamily="Consolas" MinHeight="72"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
