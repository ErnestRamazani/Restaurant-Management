<UserControl x:Class="EliteRestaurantPro.Views.ReservationFloorWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:EliteRestaurantPro.Views.Components">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <components:AdminSidebar Grid.Column="0"/>

        <Grid Grid.Column="1" Background="{StaticResource BackgroundMediumBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="32,24,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingLarge}" FontSize="26">
                        <Run Text="Reservations" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Scheduled and checked-in floor bookings. Tap a row for full details and updates."
                               Style="{StaticResource BodyText}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Margin="12,0,0,0"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="24,0,24,24" VerticalScrollBarVisibility="Auto" Style="{StaticResource EliteScrollViewer}">
                <StackPanel>
                    <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading reservations..."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>
                    </Border>

                    <Border Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,10">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Reservations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="0">
                                    <Button Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{StaticResource ReservationRowHitButton}">
                                        <Grid Margin="16,12,16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2" Background="{StaticResource GoldAccentBrush}" Opacity="0.9"/>
                                            <StackPanel Grid.Column="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding GuestName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                    <Border Grid.Column="1" Padding="10,4" CornerRadius="12" Background="#334A3F1D" BorderBrush="#776B5B2A" BorderThickness="1">
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoldAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                    <Run Text="REF · "/>
                                                    <Run Text="{Binding Id}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding PlannedStartUtc, StringFormat={}{0:g}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,4,0,0"/>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border CornerRadius="10" Padding="8,3" Margin="0,0,8,0" Background="#1AFFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                            <Run Text="Table "/><Run Text="{Binding TableLabel}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border CornerRadius="10" Padding="8,3" Margin="0,0,8,0" Background="#1AFFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                            <Run Text="Party "/><Run Text="{Binding PartySize}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border CornerRadius="10" Padding="8,3" Background="#1AFFFFFF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12">
                                                            <Run Text="Tel "/><Run Text="{Binding GuestPhone}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.RowSpan="2"
                  Background="#88070A13"
                  Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource DialogCard}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MinWidth="560"
                        MaxWidth="640"
                        MaxHeight="720"
                        Padding="4,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="620"
                                      Padding="20,16,28,8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedDetail.GuestName}" Style="{StaticResource HeadingMedium}" FontSize="40"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <TextBlock Text="#" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedDetail.Id}" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold" Margin="2,0,10,0"/>
                                    <Border Padding="10,4" CornerRadius="12" Background="#334A3F1D" BorderBrush="#776B5B2A" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedStatusText}" Foreground="{StaticResource GoldAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="VISIT" Style="{StaticResource HeadingSmall}" Margin="0,6,0,6"/>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedArrivalText}" Style="{StaticResource BodyText}"/></Border>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedEndText}" Style="{StaticResource BodyText}"/></Border>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedDetail.PartySize, StringFormat=Party size: {0}}" Style="{StaticResource BodyText}"/></Border>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedDetail.TableLabel, StringFormat=Table: {0}}" Style="{StaticResource BodyText}"/></Border>

                                <TextBlock Text="GUEST" Style="{StaticResource HeadingSmall}" Margin="0,8,0,6"/>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedDetail.GuestPhone, StringFormat=Phone: {0}}" Style="{StaticResource BodyText}"/></Border>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedDetail.GuestEmail, StringFormat=Email: {0}}" Style="{StaticResource BodyText}"/></Border>
                                <Border Style="{StaticResource GlassCard}" Padding="10" Margin="0,0,0,8"><TextBlock Text="{Binding SelectedDetail.UserNotes, StringFormat=Notes: {0}}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/></Border>

                                <TextBlock Text="ACTIONS" Style="{StaticResource HeadingSmall}" Margin="0,10,0,6"/>
                                <WrapPanel>
                                    <Button Content="Arrived"
                                            Margin="0,0,8,8"
                                            Command="{Binding MarkArrivedCommand}"
                                            IsEnabled="{Binding CanRunScheduledActions}"
                                            Style="{StaticResource GoldPrimaryButton}"/>
                                    <Button Content="Reschedule"
                                            Margin="0,0,8,8"
                                            Command="{Binding ShowReschedulePanelCommand}"
                                            IsEnabled="{Binding CanRunScheduledActions}"
                                            Style="{StaticResource GhostButton}"/>
                                    <Button Content="No show"
                                            Margin="0,0,8,8"
                                            Command="{Binding MarkNoShowCommand}"
                                            IsEnabled="{Binding CanRunScheduledActions}"
                                            Style="{StaticResource GhostButton}"/>
                                    <Button Content="Cancelled"
                                            Margin="0,0,0,8"
                                            Command="{Binding MarkCancelledCommand}"
                                            IsEnabled="{Binding CanRunScheduledActions}"
                                            Style="{StaticResource DangerButton}"/>
                                </WrapPanel>

                                <TextBlock Text="Reschedule start (local)"
                                           Style="{StaticResource HeadingSmall}"
                                           Margin="0,8,0,6"
                                           Visibility="{Binding CanRunScheduledActions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel Visibility="{Binding CanRunScheduledActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBox Text="{Binding RescheduleLocalText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource EliteTextBox}"
                                             Margin="0,0,0,10"/>
                                    <Button Content="Save new time"
                                            HorizontalAlignment="Left"
                                            MinWidth="140"
                                            Command="{Binding SaveRescheduleCommand}"
                                            Style="{StaticResource SapphireButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" Margin="20,0,20,16">
                            <Button Content="Close"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Command="{Binding CloseDetailCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
