<Application x:Class="EliteRestaurantPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EliteRestaurantPro.ViewModels"
             xmlns:views="clr-namespace:EliteRestaurantPro.Views"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- ViewModel → View DataTemplate mapping -->
            <DataTemplate DataType="{x:Type vm:RoleSelectionViewModel}">
                <views:RoleSelectionView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AdminLoginViewModel}">
                <views:AdminLoginView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:StaffLoginViewModel}">
                <views:StaffLoginView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
                <views:AdminDashboardView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardDrilldownViewModel}">
                <views:DashboardDrilldownView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
                <views:EmployeesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MenuViewModel}">
                <views:MenuView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
                <views:InventoryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
                <views:AttendanceView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TablesViewModel}">
                <views:TablesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AdminOrdersViewModel}">
                <views:AdminOrdersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:KitchenOrdersViewModel}">
                <views:KitchenOrdersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ServerPickupViewModel}">
                <views:ServerPickupView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:CreateOrderViewModel}">
                <views:CreateOrderView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MoneyViewModel}">
                <views:MoneyView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SalaryViewModel}">
                <views:SalaryView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AppearanceSettingsViewModel}">
                <views:AppearanceSettingsView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
