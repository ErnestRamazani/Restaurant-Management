<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Condition="'$(RELEASE_DISTRIBUTION)' == 'true'">
    <DefineConstants>$(DefineConstants);RELEASE_DISTRIBUTION</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\assets\images\eliterestaurant\elite-restaurant-app.ico</ApplicationIcon>
    <StartupObject>EliteRestaurantPro.App</StartupObject>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EliteRestaurant.Core\EliteRestaurant.Core.csproj" />
    <ProjectReference Include="..\EliteRestaurant.Contracts\EliteRestaurant.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\EliteRestaurant.Api\wwwroot\locales\en.json" Link="Locales\en.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\EliteRestaurant.Api\wwwroot\locales\fr.json" Link="Locales\fr.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\assets\images\eliterestaurant\elite-restaurant-app.ico" Link="elite-restaurant-app.ico" />
  </ItemGroup>

</Project>
