{
    "version": "0.2.0",
    "configurations": [
        {
            // WPF: avoid internalConsole — it often prevents the window from showing under F5.
            "name": "Launch EliteRestaurantPro (WPF)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/EliteRestaurantPro/bin/Debug/net8.0-windows/EliteRestaurantPro.exe",
            "args": [],
            "cwd": "${workspaceFolder}/EliteRestaurantPro",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}