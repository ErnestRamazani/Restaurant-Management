{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "PostgreSQL URL for EliteRestaurant.Api. Migrations run at startup (see DatabaseInitializer). Set DATABASE_URL / ELITE_POSTGRES_CONNECTION env, or paste a connection string here for local runs.",
    "DefaultConnection": ""
  },
  "LanHttps": {
    "CertificatePath": "certs/elite-lan.pfx",
    "CertificatePassword": "",
    "HttpPort": 5223,
    "HttpsPort": 7194
  },
  "Cors": {
    "AllowedOrigins": [
      "https://starfish-app-owtoz.ondigitalocean.app",
      "http://localhost:8080",
      "http://127.0.0.1:8080",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "CurrencyPricing": {
    "TaxPercent": 7,
    "ServicePercent": 10
  },
  "Jwt": {
    "Issuer": "EliteRestaurant.Local",
    "Audience": "EliteRestaurant",
    "SigningKey": "LOCAL_DEVELOPMENT_ONLY_CHANGE_IN_PRODUCTION_32_CHARS_MINIMUM",
    "ExpirationHours": 12
  },
  "Auth": {
    "DesktopAdminAcceptAnyCredentials": false
  },
  "Localization": {
    "DefaultLanguage": "en",
    "SupportedLanguages": [ "en", "fr" ],
    "EnableCaching": true,
    "CacheDurationMinutes": 60
  },
  "ReservationScheduling": {
    "BufferMinutes": 15,
    "DefaultDurationMinutes": 105,
    "SuggestionSlotStepMinutes": 30,
    "SuggestionHorizonDays": 14
  },
  "ReservationAutomation": {
    "NoShowGraceMinutes": 15,
    "DefaultTurnMinutes": 105,
    "ReminderHoursBefore": 2,
    "ScannerIntervalSeconds": 60
  },
  "Tenancy": {
    "PlatformApiHosts": [
      "starfish-app-owtoz.ondigitalocean.app"
    ]
  }
}
